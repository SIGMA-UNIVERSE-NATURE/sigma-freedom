#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.DNA39.CURIOSITY.ENGINE.NATIVE][VERSION=1.0]

DEF load_text(path) {
    RETURN host("read_text", path, NULL, NULL);
}

DEF present(value) {
    IF (value == "") { RETURN 0.0; }
    IF (value == "NONE") { RETURN 0.0; }
    RETURN 1.0;
}

DEF exact(value, expected) {
    IF (value == expected) { RETURN 1.0; }
    RETURN 0.0;
}

DEF count_valid_0_2(value) {
    IF (value == "0") { RETURN 1.0; }
    IF (value == "1") { RETURN 1.0; }
    IF (value == "2") { RETURN 1.0; }
    RETURN 0.0;
}

DEF target_count_valid_active(value) {
    IF (value == "1") { RETURN 1.0; }
    IF (value == "2") { RETURN 1.0; }
    RETURN 0.0;
}

DEF gain_token_valid(value) {
    IF (value == "0") { RETURN 1.0; }
    IF (value == "1") { RETURN 1.0; }
    IF (value == "2") { RETURN 1.0; }
    IF (value == "3") { RETURN 1.0; }
    IF (value == "4") { RETURN 1.0; }
    IF (value == "5") { RETURN 1.0; }
    IF (value == "6") { RETURN 1.0; }
    IF (value == "7") { RETURN 1.0; }
    IF (value == "8") { RETURN 1.0; }
    IF (value == "9") { RETURN 1.0; }
    RETURN 0.0;
}

DEF gain_value(value) {
    IF (value == "0") { RETURN 0.0; }
    IF (value == "1") { RETURN 1.0; }
    IF (value == "2") { RETURN 2.0; }
    IF (value == "3") { RETURN 3.0; }
    IF (value == "4") { RETURN 4.0; }
    IF (value == "5") { RETURN 5.0; }
    IF (value == "6") { RETURN 6.0; }
    IF (value == "7") { RETURN 7.0; }
    IF (value == "8") { RETURN 8.0; }
    IF (value == "9") { RETURN 9.0; }
    RETURN -1.0;
}

DEF gap_active(count_token, slot) {
    IF (slot == "1") {
        IF (count_token == "1") { RETURN 1.0; }
        IF (count_token == "2") { RETURN 1.0; }
    }
    IF (slot == "2") {
        IF (count_token == "2") { RETURN 1.0; }
    }
    RETURN 0.0;
}

DEF candidate_active(count_token, slot) {
    IF (slot == "1") {
        IF (count_token == "1") { RETURN 1.0; }
        IF (count_token == "2") { RETURN 1.0; }
    }
    IF (slot == "2") {
        IF (count_token == "2") { RETURN 1.0; }
    }
    RETURN 0.0;
}

DEF inactive_gap_valid(active, value) {
    IF (active > 0.5) { RETURN 1.0; }
    RETURN exact(value, "NONE");
}

DEF active_target_fields_valid(active, tcount, t1, t2) {
    IF (active < 0.5) { RETURN 1.0; }
    IF (tcount == "1") {
        RETURN present(t1) * exact(t2, "NONE");
    }
    IF (tcount == "2") {
        RETURN present(t1) * present(t2);
    }
    RETURN 0.0;
}

DEF target_id_valid(id, unique_gap_count) {
    IF (id == "DNA-39-GAP-0001") {
        IF (unique_gap_count > 0.5) { RETURN 1.0; }
    }
    IF (id == "DNA-39-GAP-0002") {
        IF (unique_gap_count > 1.5) { RETURN 1.0; }
    }
    RETURN 0.0;
}

DEF candidate_target_set_valid(tcount, t1, t2, unique_gap_count) {
    IF (tcount == "1") {
        RETURN target_id_valid(t1, unique_gap_count);
    }
    IF (tcount == "2") {
        RETURN target_id_valid(t1, unique_gap_count) * target_id_valid(t2, unique_gap_count);
    }
    RETURN 0.0;
}

DEF target_distinct(active, tcount, t1, t2) {
    IF (active < 0.5) { RETURN 1.0; }
    IF (tcount == "2") {
        IF (t1 == t2) { RETURN 0.0; }
    }
    RETURN 1.0;
}

DEF choose_stage1(dep_valid, gap_count_valid, candidate_count_valid) {
    IF (dep_valid < 0.5) { RETURN "DEPENDENCY_BINDING_INVALID"; }
    IF (gap_count_valid < 0.5) { RETURN "GAP_COUNT_ENCODING_INVALID"; }
    IF (candidate_count_valid < 0.5) { RETURN "CANDIDATE_COUNT_ENCODING_INVALID"; }
    RETURN "CONTINUE";
}

DEF choose_stage2(gap_values_present, inactive_gap_validity, no_gap_experiment_gate) {
    IF (gap_values_present < 0.5) { RETURN "KNOWLEDGE_GAP_VALUE_REQUIRED"; }
    IF (inactive_gap_validity < 0.5) { RETURN "KNOWLEDGE_GAP_ENCODING_INVALID"; }
    IF (no_gap_experiment_gate < 0.5) { RETURN "EXPERIMENT_WITHOUT_KNOWLEDGE_GAP_FORBIDDEN"; }
    RETURN "CONTINUE";
}

DEF choose_stage3(exp_ids_present, designs_present, gain_validity, target_counts_valid) {
    IF (exp_ids_present < 0.5) { RETURN "EXPERIMENT_ID_REQUIRED"; }
    IF (designs_present < 0.5) { RETURN "EXPERIMENT_DESIGN_REQUIRED"; }
    IF (gain_validity < 0.5) { RETURN "EXPECTED_INFORMATION_GAIN_ENCODING_INVALID"; }
    IF (target_counts_valid < 0.5) { RETURN "TARGET_GAP_COUNT_ENCODING_INVALID"; }
    RETURN "CONTINUE";
}

DEF choose_stage4(target_fields_valid, inactive_candidate_validity, exp_ids_distinct, targets_valid) {
    IF (target_fields_valid < 0.5) { RETURN "TARGET_GAP_ENCODING_INVALID"; }
    IF (inactive_candidate_validity < 0.5) { RETURN "INACTIVE_CANDIDATE_ENCODING_INVALID"; }
    IF (exp_ids_distinct < 0.5) { RETURN "DUPLICATE_EXPERIMENT_ID"; }
    IF (targets_valid < 0.5) { RETURN "UNKNOWN_TARGET_GAP"; }
    RETURN "CONTINUE";
}

DEF choose_stage5(targets_distinct, tie_supported, store_valid, capacity) {
    IF (targets_distinct < 0.5) { RETURN "DUPLICATE_TARGET_GAP"; }
    IF (tie_supported < 0.5) { RETURN "EQUAL_EIG_TIE_BREAK_NOT_PROVEN"; }
    IF (store_valid < 0.5) { RETURN "CURIOSITY_STORE_INVALID"; }
    IF (capacity < 0.5) { RETURN "CURIOSITY_CAPACITY_REACHED"; }
    RETURN "CURIOSITY_CYCLE_EVALUATED";
}

DEF choose_status4(s1, s2, s3, s4) {
    IF (s1 != "CONTINUE") { RETURN s1; }
    IF (s2 != "CONTINUE") { RETURN s2; }
    IF (s3 != "CONTINUE") { RETURN s3; }
    RETURN s4;
}

DEF choose_status2(prior, s5) {
    IF (prior != "CONTINUE") { RETURN prior; }
    RETURN s5;
}

⟡(Σ.DNA39_CURIOSITY_ENGINE_NATIVE_V1) {
    ⚡ CASE_ID: load_text(".sigma_exec/DNA39_NATIVE_ADMISSION_V1/input/case_id.txt");
    ⚡ STATE_SCHEMA: load_text(".sigma_exec/DNA39_NATIVE_ADMISSION_V1/input/state_schema.txt");
    ⚡ GAP_COUNT_TOKEN: load_text(".sigma_exec/DNA39_NATIVE_ADMISSION_V1/input/gap_count.txt");
    ⚡ GAP1: load_text(".sigma_exec/DNA39_NATIVE_ADMISSION_V1/input/gap1.txt");
    ⚡ GAP2: load_text(".sigma_exec/DNA39_NATIVE_ADMISSION_V1/input/gap2.txt");
    ⚡ CANDIDATE_COUNT_TOKEN: load_text(".sigma_exec/DNA39_NATIVE_ADMISSION_V1/input/candidate_count.txt");

    ⚡ E1_ID: load_text(".sigma_exec/DNA39_NATIVE_ADMISSION_V1/input/experiment1_id.txt");
    ⚡ E1_TARGET_COUNT: load_text(".sigma_exec/DNA39_NATIVE_ADMISSION_V1/input/experiment1_target_count.txt");
    ⚡ E1_TARGET1: load_text(".sigma_exec/DNA39_NATIVE_ADMISSION_V1/input/experiment1_target1.txt");
    ⚡ E1_TARGET2: load_text(".sigma_exec/DNA39_NATIVE_ADMISSION_V1/input/experiment1_target2.txt");
    ⚡ E1_GAIN: load_text(".sigma_exec/DNA39_NATIVE_ADMISSION_V1/input/experiment1_gain.txt");
    ⚡ E1_DESIGN: load_text(".sigma_exec/DNA39_NATIVE_ADMISSION_V1/input/experiment1_design.txt");

    ⚡ E2_ID: load_text(".sigma_exec/DNA39_NATIVE_ADMISSION_V1/input/experiment2_id.txt");
    ⚡ E2_TARGET_COUNT: load_text(".sigma_exec/DNA39_NATIVE_ADMISSION_V1/input/experiment2_target_count.txt");
    ⚡ E2_TARGET1: load_text(".sigma_exec/DNA39_NATIVE_ADMISSION_V1/input/experiment2_target1.txt");
    ⚡ E2_TARGET2: load_text(".sigma_exec/DNA39_NATIVE_ADMISSION_V1/input/experiment2_target2.txt");
    ⚡ E2_GAIN: load_text(".sigma_exec/DNA39_NATIVE_ADMISSION_V1/input/experiment2_gain.txt");
    ⚡ E2_DESIGN: load_text(".sigma_exec/DNA39_NATIVE_ADMISSION_V1/input/experiment2_design.txt");

    ⚡ DEPENDENCY_BINDING_VALID:
        present(CASE_ID)
        * exact(STATE_SCHEMA, "SIGMA_UNIFIED_COGNITIVE_STATE_V1");
    ⚡ GAP_COUNT_ENCODING_VALID: count_valid_0_2(GAP_COUNT_TOKEN);
    ⚡ CANDIDATE_COUNT_ENCODING_VALID: count_valid_0_2(CANDIDATE_COUNT_TOKEN);

    ⚡ G1_ACTIVE: gap_active(GAP_COUNT_TOKEN, "1");
    ⚡ G2_ACTIVE: gap_active(GAP_COUNT_TOKEN, "2");
    ⚡ GAP1_PRESENT: 1.0;
    ⚡ GAP2_PRESENT: 1.0;
    IF (G1_ACTIVE > 0.5) { ⚡ GAP1_PRESENT: present(GAP1); }
    IF (G2_ACTIVE > 0.5) { ⚡ GAP2_PRESENT: present(GAP2); }
    ⚡ GAP_VALUES_PRESENT: GAP1_PRESENT * GAP2_PRESENT;
    ⚡ INACTIVE_GAP_ENCODING_VALID:
        inactive_gap_valid(G1_ACTIVE, GAP1)
        * inactive_gap_valid(G2_ACTIVE, GAP2);

    ⚡ GAPS_DEDUPLICATED: 0.0;
    IF (G2_ACTIVE > 0.5) {
        IF (GAP1 == GAP2) { ⚡ GAPS_DEDUPLICATED: 1.0; }
    }

    ⚡ UNIQUE_GAP_COUNT: 0.0;
    ⚡ UNIQUE_GAP_COUNT_TOKEN: "0";
    ⚡ MATERIALIZED_GAP1: "NONE";
    ⚡ MATERIALIZED_GAP2: "NONE";
    IF (G1_ACTIVE > 0.5) {
        IF (GAP1_PRESENT > 0.5) {
            ⚡ UNIQUE_GAP_COUNT: 1.0;
            ⚡ UNIQUE_GAP_COUNT_TOKEN: "1";
            ⚡ MATERIALIZED_GAP1: GAP1;
        }
    }
    IF (G2_ACTIVE > 0.5) {
        IF (GAP2_PRESENT > 0.5) {
            IF (GAPS_DEDUPLICATED < 0.5) {
                ⚡ UNIQUE_GAP_COUNT: 2.0;
                ⚡ UNIQUE_GAP_COUNT_TOKEN: "2";
                ⚡ MATERIALIZED_GAP2: GAP2;
            }
        }
    }

    ⚡ C1_ACTIVE: candidate_active(CANDIDATE_COUNT_TOKEN, "1");
    ⚡ C2_ACTIVE: candidate_active(CANDIDATE_COUNT_TOKEN, "2");

    ⚡ E1_ID_PRESENT: 1.0;
    ⚡ E1_DESIGN_PRESENT: 1.0;
    ⚡ E1_GAIN_VALID: 1.0;
    ⚡ E1_TARGET_COUNT_VALID: 1.0;
    IF (C1_ACTIVE > 0.5) {
        ⚡ E1_ID_PRESENT: present(E1_ID);
        ⚡ E1_DESIGN_PRESENT: present(E1_DESIGN);
        ⚡ E1_GAIN_VALID: gain_token_valid(E1_GAIN);
        ⚡ E1_TARGET_COUNT_VALID: target_count_valid_active(E1_TARGET_COUNT);
    }
    ⚡ E2_ID_PRESENT: 1.0;
    ⚡ E2_DESIGN_PRESENT: 1.0;
    ⚡ E2_GAIN_VALID: 1.0;
    ⚡ E2_TARGET_COUNT_VALID: 1.0;
    IF (C2_ACTIVE > 0.5) {
        ⚡ E2_ID_PRESENT: present(E2_ID);
        ⚡ E2_DESIGN_PRESENT: present(E2_DESIGN);
        ⚡ E2_GAIN_VALID: gain_token_valid(E2_GAIN);
        ⚡ E2_TARGET_COUNT_VALID: target_count_valid_active(E2_TARGET_COUNT);
    }

    ⚡ EXPERIMENT_IDS_PRESENT: E1_ID_PRESENT * E2_ID_PRESENT;
    ⚡ EXPERIMENT_DESIGNS_PRESENT: E1_DESIGN_PRESENT * E2_DESIGN_PRESENT;
    ⚡ GAIN_ENCODINGS_VALID: E1_GAIN_VALID * E2_GAIN_VALID;
    ⚡ TARGET_COUNTS_VALID: E1_TARGET_COUNT_VALID * E2_TARGET_COUNT_VALID;
    ⚡ TARGET_FIELDS_ENCODING_VALID:
        active_target_fields_valid(C1_ACTIVE, E1_TARGET_COUNT, E1_TARGET1, E1_TARGET2)
        * active_target_fields_valid(C2_ACTIVE, E2_TARGET_COUNT, E2_TARGET1, E2_TARGET2);
    ⚡ E1_INACTIVE_ENCODING_VALID: 1.0;
    IF (C1_ACTIVE < 0.5) {
        ⚡ E1_INACTIVE_ENCODING_VALID:
            exact(E1_ID, "NONE")
            * exact(E1_TARGET_COUNT, "0")
            * exact(E1_TARGET1, "NONE")
            * exact(E1_TARGET2, "NONE")
            * exact(E1_GAIN, "NONE")
            * exact(E1_DESIGN, "NONE");
    }
    ⚡ E2_INACTIVE_ENCODING_VALID: 1.0;
    IF (C2_ACTIVE < 0.5) {
        ⚡ E2_INACTIVE_ENCODING_VALID:
            exact(E2_ID, "NONE")
            * exact(E2_TARGET_COUNT, "0")
            * exact(E2_TARGET1, "NONE")
            * exact(E2_TARGET2, "NONE")
            * exact(E2_GAIN, "NONE")
            * exact(E2_DESIGN, "NONE");
    }
    ⚡ INACTIVE_CANDIDATE_ENCODING_VALID:
        E1_INACTIVE_ENCODING_VALID * E2_INACTIVE_ENCODING_VALID;

    ⚡ EXPERIMENT_IDS_DISTINCT: 1.0;
    IF (C2_ACTIVE > 0.5) {
        IF (E1_ID == E2_ID) { ⚡ EXPERIMENT_IDS_DISTINCT: 0.0; }
    }

    ⚡ E1_TARGET_GAPS_VALID: 1.0;
    IF (C1_ACTIVE > 0.5) {
        ⚡ E1_TARGET_GAPS_VALID:
            candidate_target_set_valid(E1_TARGET_COUNT, E1_TARGET1, E1_TARGET2, UNIQUE_GAP_COUNT);
    }
    ⚡ E2_TARGET_GAPS_VALID: 1.0;
    IF (C2_ACTIVE > 0.5) {
        ⚡ E2_TARGET_GAPS_VALID:
            candidate_target_set_valid(E2_TARGET_COUNT, E2_TARGET1, E2_TARGET2, UNIQUE_GAP_COUNT);
    }
    ⚡ TARGET_GAPS_VALID: E1_TARGET_GAPS_VALID * E2_TARGET_GAPS_VALID;
    ⚡ TARGET_GAPS_DISTINCT:
        target_distinct(C1_ACTIVE, E1_TARGET_COUNT, E1_TARGET1, E1_TARGET2)
        * target_distinct(C2_ACTIVE, E2_TARGET_COUNT, E2_TARGET1, E2_TARGET2);

    ⚡ CANDIDATE_COUNT_VALUE: 0.0;
    IF (C1_ACTIVE > 0.5) { ⚡ CANDIDATE_COUNT_VALUE: 1.0; }
    IF (C2_ACTIVE > 0.5) { ⚡ CANDIDATE_COUNT_VALUE: 2.0; }
    ⚡ NO_GAP_EXPERIMENT_GATE: 1.0;
    IF (UNIQUE_GAP_COUNT < 0.5) {
        IF (CANDIDATE_COUNT_VALUE > 0.5) { ⚡ NO_GAP_EXPERIMENT_GATE: 0.0; }
    }

    ⚡ E1_GAIN_VALUE: gain_value(E1_GAIN);
    ⚡ E2_GAIN_VALUE: gain_value(E2_GAIN);
    ⚡ EQUAL_EIG_TIE: 0.0;
    IF (C2_ACTIVE > 0.5) {
        IF (GAIN_ENCODINGS_VALID > 0.5) {
            IF (E1_GAIN_VALUE == E2_GAIN_VALUE) { ⚡ EQUAL_EIG_TIE: 1.0; }
        }
    }
    ⚡ TIE_BREAK_SUPPORTED: 1.0 - EQUAL_EIG_TIE;

    ⚡ EXPERIMENT_SELECTED: 0.0;
    ⚡ SELECTED_EXPERIMENT_ID: "NONE";
    ⚡ SELECTED_GAIN_TOKEN: "NONE";
    IF (UNIQUE_GAP_COUNT > 0.5) {
        IF (C1_ACTIVE > 0.5) {
            IF (C2_ACTIVE < 0.5) {
                ⚡ EXPERIMENT_SELECTED: 1.0;
                ⚡ SELECTED_EXPERIMENT_ID: E1_ID;
                ⚡ SELECTED_GAIN_TOKEN: E1_GAIN;
            }
        }
        IF (C2_ACTIVE > 0.5) {
            IF (EQUAL_EIG_TIE < 0.5) {
                IF (E1_GAIN_VALUE > E2_GAIN_VALUE) {
                    ⚡ EXPERIMENT_SELECTED: 1.0;
                    ⚡ SELECTED_EXPERIMENT_ID: E1_ID;
                    ⚡ SELECTED_GAIN_TOKEN: E1_GAIN;
                }
                IF (E2_GAIN_VALUE > E1_GAIN_VALUE) {
                    ⚡ EXPERIMENT_SELECTED: 1.0;
                    ⚡ SELECTED_EXPERIMENT_ID: E2_ID;
                    ⚡ SELECTED_GAIN_TOKEN: E2_GAIN;
                }
            }
        }
    }

    ⚡ MAX_EIG_SELECTION_VALID: 1.0;
    IF (C1_ACTIVE > 0.5) {
        IF (C2_ACTIVE > 0.5) {
            IF (EQUAL_EIG_TIE < 0.5) {
                IF (E1_GAIN_VALUE > E2_GAIN_VALUE) {
                    IF (SELECTED_EXPERIMENT_ID != E1_ID) { ⚡ MAX_EIG_SELECTION_VALID: 0.0; }
                }
                IF (E2_GAIN_VALUE > E1_GAIN_VALUE) {
                    IF (SELECTED_EXPERIMENT_ID != E2_ID) { ⚡ MAX_EIG_SELECTION_VALID: 0.0; }
                }
            }
        }
    }

    ⚡ STRUCTURALLY_VALID:
        DEPENDENCY_BINDING_VALID
        * GAP_COUNT_ENCODING_VALID
        * CANDIDATE_COUNT_ENCODING_VALID
        * GAP_VALUES_PRESENT
        * INACTIVE_GAP_ENCODING_VALID
        * NO_GAP_EXPERIMENT_GATE
        * EXPERIMENT_IDS_PRESENT
        * EXPERIMENT_DESIGNS_PRESENT
        * GAIN_ENCODINGS_VALID
        * TARGET_COUNTS_VALID
        * TARGET_FIELDS_ENCODING_VALID
        * INACTIVE_CANDIDATE_ENCODING_VALID
        * EXPERIMENT_IDS_DISTINCT
        * TARGET_GAPS_VALID
        * TARGET_GAPS_DISTINCT
        * TIE_BREAK_SUPPORTED
        * MAX_EIG_SELECTION_VALID;

    ⚡ CYCLE_STATUS: "NO_KNOWLEDGE_GAP_DETECTED";
    IF (UNIQUE_GAP_COUNT > 0.5) {
        ⚡ CYCLE_STATUS: "KNOWLEDGE_GAP_DETECTED_NO_EXPERIMENT";
        IF (EXPERIMENT_SELECTED > 0.5) {
            ⚡ CYCLE_STATUS: "KNOWLEDGE_GAP_EXPERIMENT_SELECTED";
        }
    }

    ⚡ STORE_PATH: ".sigma_exec/DNA39_NATIVE_ADMISSION_V1/state/curiosity_cycle_ledger.memory";
    ⚡ STORE_HEADER: "SCHEMA=SIGMA_DNA39_CURIOSITY_CYCLE_LEDGER_V1";
    ⚡ STORE_TEXT: load_text(STORE_PATH);
    ⚡ STORE_EMPTY: exact(STORE_TEXT, "");
    ⚡ STORE_LINES: host("str_split", STORE_TEXT, "\n", NULL);
    ⚡ STORE_LINE_TOTAL: host("list_len", STORE_LINES, NULL, NULL);
    ⚡ MAX_CYCLE_RECORDS: 64.0;
    ⚡ MAX_STORE_SPLIT_LINES: 65.0;
    ⚡ STORE_RECORD_LIMIT_EXCEEDED: 0.0;
    IF (MAX_STORE_SPLIT_LINES < STORE_LINE_TOTAL) { ⚡ STORE_RECORD_LIMIT_EXCEEDED: 1.0; }

    ⚡ STORE_HEADER_OK: 0.0;
    IF (STORE_EMPTY > 0.5) { ⚡ STORE_HEADER_OK: 1.0; }
    IF (STORE_EMPTY < 0.5) {
        IF (STORE_RECORD_LIMIT_EXCEEDED < 0.5) {
            ⚡ FIRST_LINE: host("list_get", STORE_LINES, 0, NULL);
            ⚡ STORE_HEADER_OK: exact(FIRST_LINE, STORE_HEADER);
        }
    }

    ⚡ CYCLE_RECORD_COUNT_BEFORE: 0.0;
    ⚡ INVALID_STORE_RECORD_COUNT: 0.0;
    ⚡ I: 1.0;
    IF (STORE_RECORD_LIMIT_EXCEEDED < 0.5) {
        WHILE (I < STORE_LINE_TOTAL) {
            ⚡ LINE: host("list_get", STORE_LINES, I, NULL);
            ⚡ PARTS: host("str_split", LINE, "||", NULL);
            ⚡ PART_TOTAL: host("list_len", PARTS, NULL, NULL);
            ⚡ RECORD_VALID: 0.0;
            IF (PART_TOTAL == 16) {
                ⚡ RPREFIX: host("list_get", PARTS, 0, NULL);
                ⚡ RCASE: host("list_get", PARTS, 1, NULL);
                ⚡ RGC: host("list_get", PARTS, 2, NULL);
                ⚡ RG1: host("list_get", PARTS, 3, NULL);
                ⚡ RG2: host("list_get", PARTS, 4, NULL);
                ⚡ RCC: host("list_get", PARTS, 5, NULL);
                ⚡ RE1: host("list_get", PARTS, 6, NULL);
                ⚡ RGAIN1: host("list_get", PARTS, 7, NULL);
                ⚡ RE2: host("list_get", PARTS, 8, NULL);
                ⚡ RGAIN2: host("list_get", PARTS, 9, NULL);
                ⚡ RSELECTED: host("list_get", PARTS, 10, NULL);
                ⚡ RSELID: host("list_get", PARTS, 11, NULL);
                ⚡ RSELGAIN: host("list_get", PARTS, 12, NULL);
                ⚡ RSTATUS: host("list_get", PARTS, 13, NULL);
                ⚡ REXECUTED: host("list_get", PARTS, 14, NULL);
                ⚡ RCOMMIT: host("list_get", PARTS, 15, NULL);

                ⚡ RGC_VALID: count_valid_0_2(RGC);
                ⚡ RCC_VALID: count_valid_0_2(RCC);
                ⚡ RGAP_ENCODING_VALID: 0.0;
                IF (RGC == "0") {
                    ⚡ RGAP_ENCODING_VALID: exact(RG1, "NONE") * exact(RG2, "NONE");
                }
                IF (RGC == "1") {
                    ⚡ RGAP_ENCODING_VALID: present(RG1) * exact(RG2, "NONE");
                }
                IF (RGC == "2") {
                    ⚡ RGAP_ENCODING_VALID: present(RG1) * present(RG2);
                }

                ⚡ RCAND_ENCODING_VALID: 0.0;
                ⚡ REXPECTED_SELECTED: "0";
                ⚡ REXPECTED_SELID: "NONE";
                ⚡ REXPECTED_SELGAIN: "NONE";
                IF (RCC == "0") {
                    ⚡ RCAND_ENCODING_VALID:
                        exact(RE1, "NONE") * exact(RGAIN1, "NONE")
                        * exact(RE2, "NONE") * exact(RGAIN2, "NONE");
                }
                IF (RCC == "1") {
                    ⚡ RCAND_ENCODING_VALID:
                        present(RE1) * gain_token_valid(RGAIN1)
                        * exact(RE2, "NONE") * exact(RGAIN2, "NONE");
                    ⚡ REXPECTED_SELECTED: "1";
                    ⚡ REXPECTED_SELID: RE1;
                    ⚡ REXPECTED_SELGAIN: RGAIN1;
                }
                IF (RCC == "2") {
                    ⚡ RV1: gain_value(RGAIN1);
                    ⚡ RV2: gain_value(RGAIN2);
                    ⚡ RCAND_ENCODING_VALID:
                        present(RE1) * gain_token_valid(RGAIN1)
                        * present(RE2) * gain_token_valid(RGAIN2);
                    IF (RE1 == RE2) { ⚡ RCAND_ENCODING_VALID: 0.0; }
                    IF (RV1 == RV2) { ⚡ RCAND_ENCODING_VALID: 0.0; }
                    IF (RV1 > RV2) {
                        ⚡ REXPECTED_SELECTED: "1";
                        ⚡ REXPECTED_SELID: RE1;
                        ⚡ REXPECTED_SELGAIN: RGAIN1;
                    }
                    IF (RV2 > RV1) {
                        ⚡ REXPECTED_SELECTED: "1";
                        ⚡ REXPECTED_SELID: RE2;
                        ⚡ REXPECTED_SELGAIN: RGAIN2;
                    }
                }

                ⚡ REXPECTED_STATUS: "NO_KNOWLEDGE_GAP_DETECTED";
                IF (RGC == "1") { ⚡ REXPECTED_STATUS: "KNOWLEDGE_GAP_DETECTED_NO_EXPERIMENT"; }
                IF (RGC == "2") { ⚡ REXPECTED_STATUS: "KNOWLEDGE_GAP_DETECTED_NO_EXPERIMENT"; }
                IF (RCC == "1") { ⚡ REXPECTED_STATUS: "KNOWLEDGE_GAP_EXPERIMENT_SELECTED"; }
                IF (RCC == "2") { ⚡ REXPECTED_STATUS: "KNOWLEDGE_GAP_EXPERIMENT_SELECTED"; }

                ⚡ RECORD_VALID:
                    exact(RPREFIX, "CYCLE")
                    * present(RCASE)
                    * RGC_VALID
                    * RGAP_ENCODING_VALID
                    * RCC_VALID
                    * RCAND_ENCODING_VALID
                    * exact(RSELECTED, REXPECTED_SELECTED)
                    * exact(RSELID, REXPECTED_SELID)
                    * exact(RSELGAIN, REXPECTED_SELGAIN)
                    * exact(RSTATUS, REXPECTED_STATUS)
                    * exact(REXECUTED, "EXECUTED=0")
                    * exact(RCOMMIT, "COMMIT=YES");

                IF (RGC == "0") {
                    IF (RCC != "0") { ⚡ RECORD_VALID: 0.0; }
                }
                IF (RECORD_VALID > 0.5) { ⚡ CYCLE_RECORD_COUNT_BEFORE: CYCLE_RECORD_COUNT_BEFORE + 1.0; }
            }
            IF (RECORD_VALID < 0.5) { ⚡ INVALID_STORE_RECORD_COUNT: INVALID_STORE_RECORD_COUNT + 1.0; }
            ⚡ I: I + 1.0;
        }
    }

    ⚡ STORE_STATE_VALID: STORE_HEADER_OK * (1.0 - STORE_RECORD_LIMIT_EXCEEDED);
    IF (INVALID_STORE_RECORD_COUNT > 0.0) { ⚡ STORE_STATE_VALID: 0.0; }

    ⚡ STATE_CAPACITY_AVAILABLE: 0.0;
    IF (CYCLE_RECORD_COUNT_BEFORE < 64.0) { ⚡ STATE_CAPACITY_AVAILABLE: 1.0; }

    ⚡ RETAIN_ELIGIBLE: STRUCTURALLY_VALID * STORE_STATE_VALID * STATE_CAPACITY_AVAILABLE;
    ⚡ WRITE_ATTEMPTED: 0.0;
    ⚡ WRITE_RC: 0.0;
    ⚡ WRITE_READBACK_MATCH: 0.0;
    ⚡ RETAINED_RECORD_COUNT: 0.0;

    IF (RETAIN_ELIGIBLE > 0.5) {
        ⚡ STORE_E1: "NONE";
        ⚡ STORE_G1: "NONE";
        ⚡ STORE_E2: "NONE";
        ⚡ STORE_G2: "NONE";
        IF (C1_ACTIVE > 0.5) {
            ⚡ STORE_E1: E1_ID;
            ⚡ STORE_G1: E1_GAIN;
        }
        IF (C2_ACTIVE > 0.5) {
            ⚡ STORE_E2: E2_ID;
            ⚡ STORE_G2: E2_GAIN;
        }
        ⚡ SELECTED_TOKEN: "0";
        IF (EXPERIMENT_SELECTED > 0.5) { ⚡ SELECTED_TOKEN: "1"; }
        ⚡ RECORD_LINE:
            "CYCLE||" + CASE_ID
            + "||" + UNIQUE_GAP_COUNT_TOKEN
            + "||" + MATERIALIZED_GAP1
            + "||" + MATERIALIZED_GAP2
            + "||" + CANDIDATE_COUNT_TOKEN
            + "||" + STORE_E1
            + "||" + STORE_G1
            + "||" + STORE_E2
            + "||" + STORE_G2
            + "||" + SELECTED_TOKEN
            + "||" + SELECTED_EXPERIMENT_ID
            + "||" + SELECTED_GAIN_TOKEN
            + "||" + CYCLE_STATUS
            + "||EXECUTED=0||COMMIT=YES";
        ⚡ PROPOSED_STORE: STORE_HEADER + "\n" + RECORD_LINE;
        IF (STORE_EMPTY < 0.5) { ⚡ PROPOSED_STORE: STORE_TEXT + "\n" + RECORD_LINE; }
        ⚡ WRITE_ATTEMPTED: 1.0;
        ⚡ WRITE_RC: host("write_text", STORE_PATH, PROPOSED_STORE, NULL);
        ⚡ READBACK_TEXT: load_text(STORE_PATH);
        ⚡ WRITE_READBACK_MATCH: exact(READBACK_TEXT, PROPOSED_STORE);
        IF (WRITE_READBACK_MATCH > 0.5) { ⚡ RETAINED_RECORD_COUNT: 1.0; }
    }

    ⚡ CYCLE_RECORD_COUNT_AFTER: CYCLE_RECORD_COUNT_BEFORE + RETAINED_RECORD_COUNT;
    ⚡ STATE_MUTATED: 0.0;
    IF (RETAINED_RECORD_COUNT > 0.5) { ⚡ STATE_MUTATED: 1.0; }

    ⚡ S1: choose_stage1(DEPENDENCY_BINDING_VALID, GAP_COUNT_ENCODING_VALID, CANDIDATE_COUNT_ENCODING_VALID);
    ⚡ S2: choose_stage2(GAP_VALUES_PRESENT, INACTIVE_GAP_ENCODING_VALID, NO_GAP_EXPERIMENT_GATE);
    ⚡ S3: choose_stage3(EXPERIMENT_IDS_PRESENT, EXPERIMENT_DESIGNS_PRESENT, GAIN_ENCODINGS_VALID, TARGET_COUNTS_VALID);
    ⚡ S4: choose_stage4(TARGET_FIELDS_ENCODING_VALID, INACTIVE_CANDIDATE_ENCODING_VALID, EXPERIMENT_IDS_DISTINCT, TARGET_GAPS_VALID);
    ⚡ S5: choose_stage5(TARGET_GAPS_DISTINCT, TIE_BREAK_SUPPORTED, STORE_STATE_VALID, STATE_CAPACITY_AVAILABLE);
    ⚡ S14: choose_status4(S1, S2, S3, S4);
    ⚡ STATUS: choose_status2(S14, S5);

    ⚡ print("DNA39_NATIVE_ADMISSION_V1");
    ⚡ print("INPUT_CASE_ID"); ⚡ print(CASE_ID);
    ⚡ print("DEPENDENCY_BINDING_VALID"); ⚡ print(DEPENDENCY_BINDING_VALID);
    ⚡ print("GAP_COUNT_ENCODING_VALID"); ⚡ print(GAP_COUNT_ENCODING_VALID);
    ⚡ print("GAP_VALUES_PRESENT"); ⚡ print(GAP_VALUES_PRESENT);
    ⚡ print("INACTIVE_GAP_ENCODING_VALID"); ⚡ print(INACTIVE_GAP_ENCODING_VALID);
    ⚡ print("GAPS_DEDUPLICATED"); ⚡ print(GAPS_DEDUPLICATED);
    ⚡ print("UNIQUE_GAP_COUNT"); ⚡ print(UNIQUE_GAP_COUNT);
    ⚡ print("CANDIDATE_COUNT_ENCODING_VALID"); ⚡ print(CANDIDATE_COUNT_ENCODING_VALID);
    ⚡ print("EXPERIMENT_IDS_PRESENT"); ⚡ print(EXPERIMENT_IDS_PRESENT);
    ⚡ print("EXPERIMENT_DESIGNS_PRESENT"); ⚡ print(EXPERIMENT_DESIGNS_PRESENT);
    ⚡ print("GAIN_ENCODINGS_VALID"); ⚡ print(GAIN_ENCODINGS_VALID);
    ⚡ print("TARGET_COUNTS_VALID"); ⚡ print(TARGET_COUNTS_VALID);
    ⚡ print("TARGET_FIELDS_ENCODING_VALID"); ⚡ print(TARGET_FIELDS_ENCODING_VALID);
    ⚡ print("INACTIVE_CANDIDATE_ENCODING_VALID"); ⚡ print(INACTIVE_CANDIDATE_ENCODING_VALID);
    ⚡ print("NO_GAP_EXPERIMENT_GATE"); ⚡ print(NO_GAP_EXPERIMENT_GATE);
    ⚡ print("EXPERIMENT_IDS_DISTINCT"); ⚡ print(EXPERIMENT_IDS_DISTINCT);
    ⚡ print("TARGET_GAPS_VALID"); ⚡ print(TARGET_GAPS_VALID);
    ⚡ print("TARGET_GAPS_DISTINCT"); ⚡ print(TARGET_GAPS_DISTINCT);
    ⚡ print("EQUAL_EIG_TIE"); ⚡ print(EQUAL_EIG_TIE);
    ⚡ print("TIE_BREAK_SUPPORTED"); ⚡ print(TIE_BREAK_SUPPORTED);
    ⚡ print("EXPERIMENT_SELECTED"); ⚡ print(EXPERIMENT_SELECTED);
    ⚡ print("SELECTED_EXPERIMENT_ID"); ⚡ print(SELECTED_EXPERIMENT_ID);
    ⚡ print("SELECTED_GAIN_TOKEN"); ⚡ print(SELECTED_GAIN_TOKEN);
    ⚡ print("MAX_EIG_SELECTION_VALID"); ⚡ print(MAX_EIG_SELECTION_VALID);
    ⚡ print("STRUCTURALLY_VALID"); ⚡ print(STRUCTURALLY_VALID);
    ⚡ print("CYCLE_STATUS"); ⚡ print(CYCLE_STATUS);
    ⚡ print("STORE_STATE_VALID"); ⚡ print(STORE_STATE_VALID);
    ⚡ print("STORE_RECORD_LIMIT_EXCEEDED"); ⚡ print(STORE_RECORD_LIMIT_EXCEEDED);
    ⚡ print("INVALID_STORE_RECORD_COUNT"); ⚡ print(INVALID_STORE_RECORD_COUNT);
    ⚡ print("CYCLE_RECORD_COUNT_BEFORE"); ⚡ print(CYCLE_RECORD_COUNT_BEFORE);
    ⚡ print("STATE_CAPACITY_AVAILABLE"); ⚡ print(STATE_CAPACITY_AVAILABLE);
    ⚡ print("RETAIN_ELIGIBLE"); ⚡ print(RETAIN_ELIGIBLE);
    ⚡ print("WRITE_ATTEMPTED"); ⚡ print(WRITE_ATTEMPTED);
    ⚡ print("WRITE_RC"); ⚡ print(WRITE_RC);
    ⚡ print("WRITE_READBACK_MATCH"); ⚡ print(WRITE_READBACK_MATCH);
    ⚡ print("RETAINED_RECORD_COUNT"); ⚡ print(RETAINED_RECORD_COUNT);
    ⚡ print("STATE_MUTATED"); ⚡ print(STATE_MUTATED);
    ⚡ print("CYCLE_RECORD_COUNT_AFTER"); ⚡ print(CYCLE_RECORD_COUNT_AFTER);
    ⚡ print("STATUS"); ⚡ print(STATUS);

    ⚡ print("CURIOSITY_ENGINE_SCHEMA"); ⚡ print("SIGMA_CURIOSITY_ENGINE_V1");
    ⚡ print("GAP_SOURCE"); ⚡ print("UNRESOLVED_UNCERTAINTY_IN_CURRENT_STRUCTURED_STATE");
    ⚡ print("KNOWLEDGE_GAP_DETECTION_REQUIRED"); ⚡ print(1.0);
    ⚡ print("EXPERIMENT_SELECTION_OBJECTIVE"); ⚡ print("MAX_EXPECTED_INFORMATION_GAIN");
    ⚡ print("EXPERIMENT_EXECUTED_BY_DNA39"); ⚡ print(0.0);
    ⚡ print("LEARNING_RUNTIME_STARTED"); ⚡ print(0.0);
    ⚡ print("WORLD_RUNTIME_STARTED"); ⚡ print(0.0);
    ⚡ print("MODEL_CALLS_STARTED"); ⚡ print(0.0);
    ⚡ print("TOOL_EXECUTION_STARTED"); ⚡ print(0.0);
    ⚡ print("EXTERNAL_ACTION_EXECUTED"); ⚡ print(0.0);
    ⚡ print("GENERAL_STRUCTURED_UNCERTAINTY_EXTRACTION_PROVEN"); ⚡ print(0.0);
    ⚡ print("GENERAL_EXPECTED_INFORMATION_GAIN_NUMERIC_SUPPORT_PROVEN"); ⚡ print(0.0);
    ⚡ print("EQUAL_EIG_LEXICOGRAPHIC_TIE_BREAK_PROVEN"); ⚡ print(0.0);
    ⚡ print("EXPERIMENT_DESIGN_SHA256_DERIVATION_PROVEN"); ⚡ print(0.0);
    ⚡ print("SEMANTIC_CURIOSITY_PROVEN"); ⚡ print(0.0);
    ⚡ print("SEMANTIC_UNDERSTANDING_PROVEN"); ⚡ print(0.0);
    ⚡ print("HOST_LEARNING"); ⚡ print(0.0);
    ⚡ print("HOST_SEMANTIC_SUBSTITUTION"); ⚡ print(0.0);
}
