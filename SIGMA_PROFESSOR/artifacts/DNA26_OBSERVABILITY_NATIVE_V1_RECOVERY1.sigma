#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.DNA26.OBSERVABILITY.NATIVE.RECOVERY1][VERSION=1.0]

DEF load_text(path) {
    RETURN host("read_text", path, NULL, NULL);
}

DEF present(value) {
    IF (value == "") { RETURN 0.0; }
    IF (value == "NONE") { RETURN 0.0; }
    RETURN 1.0;
}

DEF exact(value, expected) {
    IF (value == expected) { RETURN 1.0; }
    RETURN 0.0;
}

DEF bool_token_valid(value) {
    IF (value == "0") { RETURN 1.0; }
    IF (value == "1") { RETURN 1.0; }
    RETURN 0.0;
}

DEF bool_true(value) {
    IF (value == "1") { RETURN 1.0; }
    RETURN 0.0;
}

DEF list_encoding_valid(value) {
    IF (value == "LIST") { RETURN 1.0; }
    RETURN 0.0;
}


DEF tool_output_shape_valid(used_token, output_id) {
    IF (used_token == "1") {
        RETURN present(output_id);
    }
    IF (used_token == "0") {
        IF (output_id == "NONE") { RETURN 1.0; }
        RETURN 0.0;
    }
    RETURN 0.0;
}

DEF hypothesis_status_valid(value) {
    IF (value == "PROPOSED") { RETURN 1.0; }
    IF (value == "TESTED") { RETURN 1.0; }
    IF (value == "SUPPORTED") { RETURN 1.0; }
    IF (value == "REJECTED") { RETURN 1.0; }
    IF (value == "UNRESOLVED") { RETURN 1.0; }
    RETURN 0.0;
}

DEF record_status_valid(value) {
    IF (value == "OBSERVABILITY_ARTIFACT_VERIFIABLE") { RETURN 1.0; }
    IF (value == "OBSERVABILITY_ARTIFACT_INCOMPLETE") { RETURN 1.0; }
    RETURN 0.0;
}

DEF number_if(flag, token) {
    IF (flag < 0.5) { RETURN 0.0; }
    RETURN host("to_float", token, NULL, NULL);
}

DEF probability_valid(flag, value) {
    IF (flag < 0.5) { RETURN 0.0; }
    IF (value < 0.0) { RETURN 0.0; }
    IF (value > 1.0) { RETURN 0.0; }
    RETURN 1.0;
}

DEF number_equal(a, b) {
    IF (a == b) { RETURN 1.0; }
    RETURN 0.0;
}

DEF choose_status_1(dep_valid, list_valid, bool_valid, hypothesis_valid) {
    IF (dep_valid < 0.5) { RETURN "DEPENDENCY_BINDING_INVALID"; }
    IF (list_valid < 0.5) { RETURN "LIST_ENCODING_INVALID"; }
    IF (bool_valid < 0.5) { RETURN "BOOLEAN_ENCODING_INVALID"; }
    IF (hypothesis_valid < 0.5) { RETURN "HYPOTHESIS_STATUS_INVALID"; }
    RETURN "CONTINUE";
}

DEF choose_status_2(store_valid, artifact_supplied, duplicate_found, capacity_available) {
    IF (store_valid < 0.5) { RETURN "OBSERVABILITY_STORE_INVALID"; }
    IF (artifact_supplied < 0.5) { RETURN "NO_OBSERVABILITY_ARTIFACT_SUPPLIED"; }
    IF (duplicate_found > 0.5) { RETURN "DUPLICATE_ARTIFACT_ID_REJECTED"; }
    IF (capacity_available < 0.5) { RETURN "OBSERVABILITY_CAPACITY_REACHED"; }
    RETURN "CONTINUE";
}

DEF choose_status_3(retained, complete, structural_verifiable) {
    IF (retained < 0.5) { RETURN "OBSERVABILITY_ARTIFACT_QUALIFIED_NOT_RETAINED"; }
    IF (complete < 0.5) { RETURN "OBSERVABILITY_ARTIFACT_INCOMPLETE"; }
    IF (structural_verifiable > 0.5) { RETURN "OBSERVABILITY_ARTIFACT_VERIFIABLE"; }
    RETURN "OBSERVABILITY_ARTIFACT_INCOMPLETE";
}

DEF choose_status(stage1, stage2, stage3) {
    IF (stage1 == "CONTINUE") {
        IF (stage2 == "CONTINUE") { RETURN stage3; }
        RETURN stage2;
    }
    RETURN stage1;
}

⟡(Σ.DNA26_OBSERVABILITY_NATIVE_V1_RECOVERY1) {
    ⚡ CASE_ID: load_text(".sigma_exec/DNA26_NATIVE_ADMISSION_V1_RECOVERY1/input/case_id.txt");

