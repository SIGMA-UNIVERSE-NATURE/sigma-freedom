    ⚡ DNA09_EVALUATION_ID: load_text(".sigma_exec/DNA26_NATIVE_ADMISSION_V1_RECOVERY1/input/dna09_evaluation_id.txt");
    ⚡ DNA09_VERIFIER_ID: load_text(".sigma_exec/DNA26_NATIVE_ADMISSION_V1_RECOVERY1/input/dna09_verifier_id.txt");
    ⚡ DNA09_INDEPENDENT_TOKEN: load_text(".sigma_exec/DNA26_NATIVE_ADMISSION_V1_RECOVERY1/input/dna09_independent.txt");
