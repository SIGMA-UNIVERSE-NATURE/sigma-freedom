    ⚡ CONFIDENCE_EVIDENCE_COVERAGE_TOKEN: load_text(".sigma_exec/DNA26_NATIVE_ADMISSION_V1_RECOVERY1/input/confidence_evidence_coverage.txt");
    ⚡ CONFIDENCE_UNRESOLVED_LIST_ENCODING: load_text(".sigma_exec/DNA26_NATIVE_ADMISSION_V1_RECOVERY1/input/confidence_unresolved_list_encoding.txt");
    ⚡ CONFIDENCE_UNRESOLVED: load_text(".sigma_exec/DNA26_NATIVE_ADMISSION_V1_RECOVERY1/input/confidence_unresolved.txt");
    ⚡ CONFIDENCE_SOURCE_SHA256: load_text(".sigma_exec/DNA26_NATIVE_ADMISSION_V1_RECOVERY1/input/confidence_source_sha256.txt");

    ⚡ DNA20_CONCLUSION_ID: load_text(".sigma_exec/DNA26_NATIVE_ADMISSION_V1_RECOVERY1/input/dna20_conclusion_id.txt");
