#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.PRODUCTION.STATE.MIGRATION.ROLLBACK.VERIFIER][VERSION=2.24R1]

DEF H(op, a, b, c) {
    RETURN host(op, a, b, c);
}

⟡(Σ.PRODUCTION_STATE_MIGRATION_ROLLBACK_VERIFIER_V224R1) {

    ⚡ MODE:
        H("read_text", ".sigma_exec/SIGMA_V224R1_MODE.memory", NULL, NULL);

    ⚡ SOURCE_BEFORE_DIGEST:
        H("read_text", ".sigma_exec/SIGMA_V224R1_SOURCE_BEFORE_DIGEST.memory", NULL, NULL);

    ⚡ SOURCE_BEFORE_COUNT:
        H("read_text", ".sigma_exec/SIGMA_V224R1_SOURCE_BEFORE_COUNT.memory", NULL, NULL);

