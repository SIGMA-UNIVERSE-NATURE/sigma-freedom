    ⚡ print("DECISION", DECISION);
    ⚡ print("WRITE_DECISION_RC", WRITE_DECISION_RC);
    ⚡ print("MIGRATION_VERIFICATION_POLICY", "EXACT_CANONICAL_PACKAGE_DIGEST_AND_ENTRY_COUNT");
    ⚡ print("HOST_MIGRATION_DECISION", "NO");
    ⚡ print("HOST_ROLLBACK_DECISION", "NO");
    ⚡ print("HOST_LEARNING", "NO");
    ⚡ print("SEMANTIC_UNDERSTANDING", "NOT_PROVEN");
}
