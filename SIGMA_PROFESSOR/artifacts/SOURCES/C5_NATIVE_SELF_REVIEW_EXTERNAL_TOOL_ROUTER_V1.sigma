#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.C5.NATIVE.SELF.REVIEW.EXTERNAL.TOOL.ROUTER][VERSION=1.0]

DEF H(op, a, b, c) {
    RETURN host(op, a, b, c);
}

DEF flag_valid(v) {
    IF (v == "0") { RETURN 1; }
    IF (v == "1") { RETURN 1; }
    RETURN 0;
}

DEF digits(v) {
    IF (v == "") { RETURN 0; }

    ⚡ R: v;
    ⚡ R: H("str_replace", R, "0", "");
    ⚡ R: H("str_replace", R, "1", "");
    ⚡ R: H("str_replace", R, "2", "");
    ⚡ R: H("str_replace", R, "3", "");
    ⚡ R: H("str_replace", R, "4", "");
    ⚡ R: H("str_replace", R, "5", "");
    ⚡ R: H("str_replace", R, "6", "");
    ⚡ R: H("str_replace", R, "7", "");
    ⚡ R: H("str_replace", R, "8", "");
    ⚡ R: H("str_replace", R, "9", "");

    IF (R == "") { RETURN 1; }
    RETURN 0;
}

DEF lower_hex64(v) {
    IF (H("str_len", v, NULL, NULL) != 64) { RETURN 0; }

    ⚡ R: v;
    ⚡ R: H("str_replace", R, "0", "");
    ⚡ R: H("str_replace", R, "1", "");
    ⚡ R: H("str_replace", R, "2", "");
    ⚡ R: H("str_replace", R, "3", "");
    ⚡ R: H("str_replace", R, "4", "");
    ⚡ R: H("str_replace", R, "5", "");
    ⚡ R: H("str_replace", R, "6", "");
    ⚡ R: H("str_replace", R, "7", "");
    ⚡ R: H("str_replace", R, "8", "");
    ⚡ R: H("str_replace", R, "9", "");
    ⚡ R: H("str_replace", R, "a", "");
    ⚡ R: H("str_replace", R, "b", "");
    ⚡ R: H("str_replace", R, "c", "");
    ⚡ R: H("str_replace", R, "d", "");
    ⚡ R: H("str_replace", R, "e", "");
    ⚡ R: H("str_replace", R, "f", "");

    IF (R == "") { RETURN 1; }
    RETURN 0;
}

DEF num(v) {
    RETURN H("to_float", v, NULL, NULL);
}

DEF gt_num(a, b) {
    IF (num(a) > num(b)) { RETURN 1; }
    RETURN 0;
}

DEF lt_num(a, b) {
    IF (num(a) < num(b)) { RETURN 1; }
    RETURN 0;
}

DEF contains_text(text, token) {
    IF (token == "") { RETURN 0; }
    IF (text == "") { RETURN 0; }

    ⚡ BEFORE: H("str_len", text, NULL, NULL);
    ⚡ AFTER_TEXT: H("str_replace", text, token, "");
    ⚡ AFTER: H("str_len", AFTER_TEXT, NULL, NULL);

    IF (AFTER < BEFORE) { RETURN 1; }
    RETURN 0;
}

DEF overlap_one(desc, langs, media, token) {
    IF (contains_text(desc, token) == 1) { RETURN 1; }
    IF (contains_text(langs, token) == 1) { RETURN 1; }
    IF (contains_text(media, token) == 1) { RETURN 1; }
    RETURN 0;
}

DEF tool_valid(id, token, available, readiness, prior, material, nomat, tfail, httpfail, dfail) {
    IF (digits(id) != 1) { RETURN 0; }
    IF (token == "") { RETURN 0; }
    IF (flag_valid(available) != 1) { RETURN 0; }
    IF (digits(readiness) != 1) { RETURN 0; }
    IF (digits(prior) != 1) { RETURN 0; }
    IF (digits(material) != 1) { RETURN 0; }
    IF (digits(nomat) != 1) { RETURN 0; }
    IF (digits(tfail) != 1) { RETURN 0; }
    IF (digits(httpfail) != 1) { RETURN 0; }
    IF (digits(dfail) != 1) { RETURN 0; }
    RETURN 1;
}

DEF is_better(ov, hardfail, material, nomat, prior, readiness, id, bov, bhardfail, bmaterial, bnomat, bprior, breadiness, bid) {
    IF (gt_num(ov, bov) == 1) { RETURN 1; }
    IF (lt_num(ov, bov) == 1) { RETURN 0; }

    IF (lt_num(hardfail, bhardfail) == 1) { RETURN 1; }
    IF (gt_num(hardfail, bhardfail) == 1) { RETURN 0; }

    IF (gt_num(material, bmaterial) == 1) { RETURN 1; }
    IF (lt_num(material, bmaterial) == 1) { RETURN 0; }

    IF (lt_num(nomat, bnomat) == 1) { RETURN 1; }
    IF (gt_num(nomat, bnomat) == 1) { RETURN 0; }

    IF (lt_num(prior, bprior) == 1) { RETURN 1; }
    IF (gt_num(prior, bprior) == 1) { RETURN 0; }

    IF (gt_num(readiness, breadiness) == 1) { RETURN 1; }
    IF (lt_num(readiness, breadiness) == 1) { RETURN 0; }

    IF (lt_num(id, bid) == 1) { RETURN 1; }
    RETURN 0;
}

DEF readv(base, name) {
    RETURN H("read_text", base + "/input/" + name, NULL, NULL);
}

