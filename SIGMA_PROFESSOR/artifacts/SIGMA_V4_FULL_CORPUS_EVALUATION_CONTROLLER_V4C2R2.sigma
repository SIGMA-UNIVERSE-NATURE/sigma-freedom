#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.V4.FULL.CORPUS.EVALUATION.CONTROLLER][VERSION=4C2R2]

DEF H(op, a, b, c) {
    RETURN host(op, a, b, c);
}

DEF unary_valid(token) {
    ⚡ REST:
        H("str_replace", token, "|", "");
    IF (REST == "") {
        RETURN 1;
    }
    RETURN 0;
}

DEF field_value(field, prefix) {
    ⚡ PARTS:
        H("str_split", field, prefix, NULL);
    ⚡ N:
        H("list_len", PARTS, NULL, NULL);
    IF (N == 2) {
        ⚡ LEFT:
            H("list_get", PARTS, 0, NULL);
        IF (LEFT == "") {
            RETURN H("list_get", PARTS, 1, NULL);
        }
    }
    RETURN "__INVALID_FIELD__";
}

DEF clear_b4() {
    ⚡ C0:
        H("write_text", ".sigma_exec/SIGMA_V4B4R2_CONTEXT_ID.memory", "", NULL);
    ⚡ C1:
        H("write_text", ".sigma_exec/SIGMA_V4B4R2_CONTEXT_TEXT.memory", "", NULL);
    ⚡ C2:
        H("write_text", ".sigma_exec/SIGMA_V4B4R2_TOKEN_CURSOR.memory", "", NULL);
    ⚡ C3:
        H("write_text", ".sigma_exec/SIGMA_V4B4R2_COMPLETION.memory", "", NULL);
    ⚡ C4:
        H("write_text", ".sigma_exec/SIGMA_V4B4R2_STATUS.memory", "", NULL);
    ⚡ C5:
        H("write_text", ".sigma_exec/SIGMA_V4B4R2_LAST_EVIDENCE.memory", "", NULL);
    ⚡ C6:
        H("write_text", ".sigma_exec/SIGMA_V4B4R2_BEST_WIDTH.memory", "", NULL);
    ⚡ C7:
        H("write_text", ".sigma_exec/SIGMA_V4B4R2_BEST_SUPPORT.memory", "", NULL);
    ⚡ C8:
        H("write_text", ".sigma_exec/SIGMA_V4B4R2_PAIR_OCCURRENCES.memory", "", NULL);
    ⚡ C9:
        H("write_text", ".sigma_exec/SIGMA_V4B4R2_TRIPLE_OCCURRENCES.memory", "", NULL);
    ⚡ C10:
        H("write_text", ".sigma_exec/SIGMA_V4B4R2_QUAD_OCCURRENCES.memory", "", NULL);
    RETURN 1;
}

DEF clear_read_request() {
    ⚡ C0:
        H("write_text", ".sigma_exec/SIGMA_V4C2R2_READ_REQUEST_ID.memory", "", NULL);
    ⚡ C1:
        H("write_text", ".sigma_exec/SIGMA_V4C2R2_READ_DOC.memory", "", NULL);
    ⚡ C2:
        H("write_text", ".sigma_exec/SIGMA_V4C2R2_READ_LINE.memory", "", NULL);
    ⚡ C3:
        H("write_text", ".sigma_exec/SIGMA_V4C2R2_READ_PURPOSE.memory", "", NULL);
    RETURN 1;
}

DEF clear_read_result() {
    ⚡ C0:
        H("write_text", ".sigma_exec/SIGMA_V4C2R2_READ_RESULT_ID.memory", "", NULL);
    ⚡ C1:
        H("write_text", ".sigma_exec/SIGMA_V4C2R2_READ_RESULT_FOUND.memory", "", NULL);
    ⚡ C2:
        H("write_text", ".sigma_exec/SIGMA_V4C2R2_READ_RESULT_TEXT.memory", "", NULL);
    RETURN 1;
}

DEF learner_refusal(status) {
    IF (status == "REFUSE_INVALID_INPUT") {
        RETURN 1;
    }
    IF (status == "REFUSE_CURSOR_FORMAT") {
        RETURN 1;
    }
    IF (status == "REFUSE_SELECTED_LINE_ABI_TOKEN_LIMIT") {
        RETURN 1;
    }
    IF (status == "REFUSE_CURSOR_OUT_OF_RANGE") {
        RETURN 1;
    }
    RETURN 0;
}

⟡(Σ.V4_FULL_CORPUS_EVALUATION_CONTROLLER_4C2R2) {

