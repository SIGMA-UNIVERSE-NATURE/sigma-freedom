#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.V4.PRODUCTIVITY.WORK.ARBITER][VERSION=4A2]

DEF H(op, a, b, c) {
    RETURN host(op, a, b, c);
}

DEF source_allowed(source) {
    IF (source == "RECEIVED") {
        RETURN 1;
    }
    IF (source == "RETRYABLE") {
        RETURN 1;
    }
    IF (source == "LOCAL") {
        RETURN 1;
    }
    IF (source == "FETCH") {
        RETURN 1;
    }
    IF (source == "RECOVERED") {
        RETURN 1;
    }
    RETURN 0;
}

DEF pick_regular(last_source, received_ok, retryable_ok, local_ok, fetch_ok) {

    IF (last_source == "RECEIVED") {
        IF (retryable_ok) {
            RETURN "RETRYABLE";
        }
        IF (local_ok) {
            RETURN "LOCAL";
        }
        IF (fetch_ok) {
            RETURN "FETCH";
        }
        IF (received_ok) {
            RETURN "RECEIVED";
        }
    }

    IF (last_source == "RETRYABLE") {
        IF (local_ok) {
            RETURN "LOCAL";
        }
        IF (fetch_ok) {
            RETURN "FETCH";
        }
        IF (received_ok) {
            RETURN "RECEIVED";
        }
        IF (retryable_ok) {
            RETURN "RETRYABLE";
        }
    }

    IF (last_source == "LOCAL") {
        IF (fetch_ok) {
            RETURN "FETCH";
        }
        IF (received_ok) {
            RETURN "RECEIVED";
        }
        IF (retryable_ok) {
            RETURN "RETRYABLE";
        }
        IF (local_ok) {
            RETURN "LOCAL";
        }
    }

    IF (last_source == "FETCH") {
        IF (received_ok) {
            RETURN "RECEIVED";
        }
        IF (retryable_ok) {
            RETURN "RETRYABLE";
        }
        IF (local_ok) {
            RETURN "LOCAL";
        }
        IF (fetch_ok) {
            RETURN "FETCH";
        }
    }

    IF (last_source == "RECOVERED") {
        IF (received_ok) {
            RETURN "RECEIVED";
        }
        IF (retryable_ok) {
            RETURN "RETRYABLE";
        }
        IF (local_ok) {
            RETURN "LOCAL";
        }
        IF (fetch_ok) {
            RETURN "FETCH";
        }
    }

    IF (received_ok) {
        RETURN "RECEIVED";
    }

    IF (retryable_ok) {
        RETURN "RETRYABLE";
    }

    IF (local_ok) {
        RETURN "LOCAL";
    }

    IF (fetch_ok) {
        RETURN "FETCH";
    }

    RETURN "";
}

⟡(Σ.V4_PRODUCTIVITY_WORK_ARBITER_4A2) {

    ⚡ RECOVERED_EVENT:
        H("read_text", ".sigma_exec/SIGMA_V4A2_RECOVERED_EVENT.memory", NULL, NULL);

    ⚡ RECEIVED_WORK:
        H("read_text", ".sigma_exec/SIGMA_V4A2_RECEIVED_WORK.memory", NULL, NULL);

    ⚡ RETRYABLE_WORK:
        H("read_text", ".sigma_exec/SIGMA_V4A2_RETRYABLE_WORK.memory", NULL, NULL);

    ⚡ LOCAL_WORK:
        H("read_text", ".sigma_exec/SIGMA_V4A2_LOCAL_WORK.memory", NULL, NULL);

    ⚡ FETCH_REQUEST:
        H("read_text", ".sigma_exec/SIGMA_V4A2_FETCH_REQUEST.memory", NULL, NULL);

    ⚡ NEXT_FETCH_TEXT:
        H("read_text", ".sigma_exec/SIGMA_V4A2_NEXT_FETCH_NOT_BEFORE.memory", NULL, NULL);

    ⚡ LAST_SOURCE:
        H("read_text", ".sigma_exec/SIGMA_V4A2_LAST_SOURCE.memory", NULL, NULL);

    IF (source_allowed(LAST_SOURCE) == 0) {
        ⚡ LAST_SOURCE:
            "";
    }

    ⚡ NOW:
        H("time_now", NULL, NULL, NULL);

    ⚡ NEXT_FETCH:
        0;

    ⚡ NEXT_FETCH_PRESENT:
        1;

    IF (NEXT_FETCH_TEXT == "") {
        ⚡ NEXT_FETCH_PRESENT:
            0;
    }

    IF (NEXT_FETCH_PRESENT) {
        ⚡ NEXT_FETCH:
            H("to_int", NEXT_FETCH_TEXT, NULL, NULL);
    }

    ⚡ RECOVERED_OK:
        1;

    IF (RECOVERED_EVENT == "") {
        ⚡ RECOVERED_OK:
            0;
    }

    ⚡ RECEIVED_OK:
        1;

    IF (RECEIVED_WORK == "") {
        ⚡ RECEIVED_OK:
            0;
    }

    ⚡ RETRYABLE_OK:
        1;

    IF (RETRYABLE_WORK == "") {
        ⚡ RETRYABLE_OK:
            0;
    }

    ⚡ LOCAL_OK:
        1;

    IF (LOCAL_WORK == "") {
        ⚡ LOCAL_OK:
            0;
    }

    ⚡ FETCH_REQUEST_PRESENT:
        1;

    IF (FETCH_REQUEST == "") {
        ⚡ FETCH_REQUEST_PRESENT:
            0;
    }

    ⚡ FETCH_DUE:
        0;

    IF (FETCH_REQUEST_PRESENT) {
        IF (NEXT_FETCH_PRESENT == 0) {
            ⚡ FETCH_DUE:
                1;
        }

        IF (NEXT_FETCH_PRESENT) {
            IF (NEXT_FETCH < NOW) {
                ⚡ FETCH_DUE:
                    1;
            }
            IF (NEXT_FETCH == NOW) {
                ⚡ FETCH_DUE:
                    1;
            }
        }
    }

    ⚡ SELECTED_SOURCE:
        "";

    IF (RECOVERED_OK) {
        ⚡ SELECTED_SOURCE:
            "RECOVERED";
    }

    IF (RECOVERED_OK == 0) {
        ⚡ SELECTED_SOURCE:
            pick_regular(LAST_SOURCE, RECEIVED_OK, RETRYABLE_OK, LOCAL_OK, FETCH_DUE);
    }

    ⚡ ACTION:
        "WAIT_NO_ELIGIBLE_WORK";

    ⚡ TARGET:
        "";

    IF (SELECTED_SOURCE == "RECOVERED") {
        ⚡ ACTION:
            "EXECUTE_RECOVERED_EVENT";
        ⚡ TARGET:
            RECOVERED_EVENT;
    }

    IF (SELECTED_SOURCE == "RECEIVED") {
        ⚡ ACTION:
            "LEARN_RECEIVED_CONTEXT";
        ⚡ TARGET:
            RECEIVED_WORK;
    }

    IF (SELECTED_SOURCE == "RETRYABLE") {
        ⚡ ACTION:
            "RESUME_RETRYABLE_CONTEXT";
        ⚡ TARGET:
            RETRYABLE_WORK;
    }

    IF (SELECTED_SOURCE == "LOCAL") {
        ⚡ ACTION:
            "CONTINUE_LOCAL_CURRICULUM";
        ⚡ TARGET:
            LOCAL_WORK;
    }

    IF (SELECTED_SOURCE == "FETCH") {
        ⚡ ACTION:
            "DISPATCH_NATIVE_FETCH_REQUEST";
        ⚡ TARGET:
            FETCH_REQUEST;
    }

    ⚡ WRITE_LAST_SOURCE_RC:
        0;

    ⚡ HAS_SELECTED_SOURCE:
        1;

    IF (SELECTED_SOURCE == "") {
        ⚡ HAS_SELECTED_SOURCE:
            0;
    }

    IF (HAS_SELECTED_SOURCE) {
        ⚡ WRITE_LAST_SOURCE_RC:
            H("write_text", ".sigma_exec/SIGMA_V4A2_LAST_SOURCE.memory", SELECTED_SOURCE, NULL);
    }

    ⚡ WRITE_ACTION_RC:
        H("write_text", ".sigma_exec/SIGMA_V4A2_ACTION.memory", ACTION, NULL);

    ⚡ WRITE_TARGET_RC:
        H("write_text", ".sigma_exec/SIGMA_V4A2_TARGET.memory", TARGET, NULL);

    ⚡ print("SIGMA_V4A2_PRODUCTIVITY_WORK_ARBITER");
    ⚡ print("NOW", NOW);
    ⚡ print("NEXT_FETCH_NOT_BEFORE", NEXT_FETCH);
    ⚡ print("FETCH_DUE", FETCH_DUE);
    ⚡ print("RECOVERED_ELIGIBLE", RECOVERED_OK);
    ⚡ print("RECEIVED_ELIGIBLE", RECEIVED_OK);
    ⚡ print("RETRYABLE_ELIGIBLE", RETRYABLE_OK);
    ⚡ print("LOCAL_ELIGIBLE", LOCAL_OK);
    ⚡ print("LAST_SOURCE", LAST_SOURCE);
    ⚡ print("ACTION", ACTION);
    ⚡ print("TARGET", TARGET);
    ⚡ print("SELECTED_SOURCE", SELECTED_SOURCE);
    ⚡ print("WRITE_LAST_SOURCE_RC", WRITE_LAST_SOURCE_RC);
    ⚡ print("WRITE_ACTION_RC", WRITE_ACTION_RC);
    ⚡ print("WRITE_TARGET_RC", WRITE_TARGET_RC);
    ⚡ print("PRODUCTIVITY_POLICY", "RECOVERED_FIRST_THEN_ROUND_ROBIN_RECEIVED_RETRYABLE_LOCAL_FETCH");
    ⚡ print("ARBITER_STATE_POLICY", "SINGLE_COMPACT_LAST_SOURCE_NO_GROWING_DECISION_LEDGER");
    ⚡ print("RATE_LIMIT_IDLE_POLICY", "CONTINUE_ELIGIBLE_NONFETCH_WORK_WHEN_FETCH_NOT_DUE");
    ⚡ print("FETCHED_EQUALS_LEARNED", "NO");
    ⚡ print("HOST_WORK_SELECTION", "NO");
    ⚡ print("HOST_STAGE_DECISION", "NO");
    ⚡ print("HOST_RETRY_POLICY", "NO");
    ⚡ print("HOST_LEARNING", "NO");
    ⚡ print("STRUCTURAL_WORK_ARBITRATION_ONLY", "YES");
    ⚡ print("DECISION_HISTORY_FULL_SCAN", "NO");
    ⚡ print("COMPUTATION_BOUNDED_PER_INVOCATION", "YES");
    ⚡ print("SEMANTIC_UNDERSTANDING", "NOT_PROVEN");
}
