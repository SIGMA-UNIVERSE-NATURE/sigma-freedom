{
  "schema_version": "1.4",
  "autopilot_id": "HKA-CURRICULUM-AUTOPILOT-V1",
  "status": "ACTIVE_LIVE_CODEX_GUARDED_FAST_PATH",
  "enabled": true,
  "control_plane_branch": "hka-tree/curriculum-master",
  "default_branch_launcher": "SIGMA_LIFE",
  "poll_minutes": 5,
  "mode": "GUARDED_AUTONOMY_FAST_PATH",
  "north_star": "CINEMATIC_4K_ON_WEBSITE",
  "pipeline_knowledge_tree_contract": "AUTOPILOT/HKA_PIPELINE_KNOWLEDGE_TREE_CONTRACT.json",
  "auto_queue_role_requests": true,
  "auto_execute_queued_roles": true,
  "auto_chain_next_run": true,
  "fallback_queue": "GITHUB_ISSUE",
  "auto_open_successor_after_acceptance_and_sentinel": true,
  "fast_path": {
    "enabled": true,
    "contract": "AUTOPILOT/HKA_FAST_PATH_POLICY.json",
    "auto_fix_repairable_defects_in_same_role": true,
    "delta_first_review": true,
    "full_reaudit_only_on_semantic_change": true,
    "repairable_mechanical_defect_must_not_create_manual_handoff": true,
    "repeat_same_finding_without_new_evidence_forbidden": true
  },
  "canonical_alignment": {
    "knowledge_tree_commit": "fc799bf1104ab6352710e1801777a971b5179995",
    "b1_architecture_commit": "265bb584b5d7e36e11091289d58558408880118c",
    "scope_map_blob_sha": "bedef47958a728e3f0d56d412f7bdea3ec465856",
    "read_before_every_agent_transition": true,
    "read_applies_to": ["ORCHESTRATOR", "WORKER", "DIRECTOR", "SENTINEL"],
    "never_invent_missing_architecture": true,
    "never_override_durable_state_with_chat_example": true
  },
  "pipeline": [
    "KNOWLEDGE",
    "CURRICULUM",
    "ACADEMIC_LOCKED",
    "LESSON_REGISTRY",
    "LESSON_REGISTRY_LOCKED",
    "PROMPTS",
    "PROMPT_LOCKED",
    "IMAGE_PRODUCTION",
    "R2 STAGING",
    "INDEPENDENT QA",
    "VAULT",
    "WEB OPTIMIZE",
    "DELIVERY",
    "WEBSITE UPDATE"
  ],
  "curriculum_exit_gate": {
    "required_before_ACADEMIC_LOCKED": true,
    "all_B1_through_B6_complete": true,
    "each_B_audit_pass": true,
    "global_curriculum_audit_pass": true,
    "single_C_completion_insufficient": true,
    "single_B_completion_insufficient": true
  },
  "runner_federation": {
    "contract": "AUTOPILOT/HKA_AUTOPILOT_FEDERATION.json",
    "probe": ".github/hka_autopilot/federation_probe.py",
    "primary": "GITHUB_ACTIONS_CODEX",
    "optional": ["VERCEL_CLOUD_OBSERVER", "HP_REMOTE_OPERATOR"],
    "optional_failure_blocks_control_loop": false,
    "task_loss_on_runner_failure": false
  },
  "role_separation": {
    "WORKER": "May write only active child academic/status artifacts; must self-repair repairable defects before terminal receipt; cannot self-accept or unlock successor.",
    "DIRECTOR": "May open windows, independently review, accept or require repair, and update control-plane governance; uses delta-first re-review after repair and does not replace worker semantic authoring.",
    "SENTINEL": "Read-only for academic/control-plane state; verifies alignment rather than repeating Director academic review; may write only Sentinel checkpoint/status; cannot accept or unlock.",
    "ORCHESTRATOR": "Reads durable state and canonical Knowledge Tree, validates invariants, plans and dispatches the next role; never changes academic truth by itself and never requires manual handoff for an internally repairable defect."
  },
  "hard_gates": {
    "current_stage": "CURRICULUM",
    "director_acceptance_required": true,
    "fresh_post_acceptance_sentinel_required": true,
    "sentinel_cannot_unlock": true,
    "successor_opening_separate_transition": true,
    "future_locked_support_required": 0,
    "cross_scope_academic_mutation_required": 0,
    "accepted_stable_ids_immutable": true,
    "no_stage_skip": true
  },
  "agent_runner": {
    "workflow": ".github/workflows/hka_agent_runner.yml",
    "executor": "openai/codex-action@v1",
    "model": "gpt-5.6-sol",
    "reasoning_effort": "high",
    "permission_profile": ":workspace",
    "safety_strategy": "drop-sudo",
    "required_secret": "OPENAI_API_KEY",
    "queue_consumer": ".github/hka_autopilot/issue_queue.py",
    "write_guard": ".github/hka_autopilot/role_guard.py",
    "successor_bootstrap": ".github/hka_autopilot/successor_bootstrap.py",
    "fallback_when_secret_missing": "Keep request open and create/retain a configuration blocker; never advance state."
  },
  "delivery_intent": {
    "final_surface": "WEBSITE",
    "quality_target": "CINEMATIC_4K",
    "governance_is_means_not_product": true
  }
}
