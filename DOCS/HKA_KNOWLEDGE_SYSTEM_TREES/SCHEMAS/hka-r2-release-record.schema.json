{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hka.sigmastudy.net/schemas/hka-r2-release-record.schema.json",
  "title": "HKA R2 Immutable Release Record",
  "description": "Final audit record written to hka-c4k-audit after RELEASED.json has been verified in the vault and the release prefix lock has been applied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "batch_id",
    "run_id",
    "prompt_commit_sha",
    "manifest_sha256",
    "batch_package_sha256",
    "qa_report_sha256",
    "upload_receipt_sha256",
    "vault_bucket",
    "vault_prefix",
    "release_marker_key",
    "release_marker_sha256",
    "release_marker_verified",
    "prefix_lock_applied",
    "lock_policy",
    "released_at",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "release_id": { "type": "string", "pattern": "^HKA-W[0-9]{2}-REL-[0-9]{4}$" },
    "batch_id": { "type": "string", "pattern": "^HKA-W[0-9]{2}-B[0-9]{2}$" },
    "run_id": { "type": "string", "pattern": "^HKA-W[0-9]{2}-B[0-9]{2}-R[0-9]{2}$" },
    "prompt_commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "batch_package_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "qa_report_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "upload_receipt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "vault_bucket": { "const": "hka-c4k-vault" },
    "vault_prefix": {
      "type": "string",
      "pattern": "^v1/windows/W[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*/prompt-commit/[a-f0-9]{40}/batches/HKA-W[0-9]{2}-B[0-9]{2}/runs/HKA-W[0-9]{2}-B[0-9]{2}-R[0-9]{2}/$"
    },
    "release_marker_key": { "type": "string", "pattern": "RELEASED\\.json$" },
    "release_marker_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "release_marker_verified": { "const": true },
    "prefix_lock_applied": { "const": true },
    "lock_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["INDEFINITE", "UNTIL_DATE", "DURATION"] },
        "retain_until": { "type": "string", "format": "date-time" },
        "duration_days": { "type": "integer", "minimum": 1 }
      }
    },
    "released_at": { "type": "string", "format": "date-time" },
    "status": { "const": "R2_VERIFIED" },
    "supersedes_release_id": { "type": "string", "pattern": "^HKA-W[0-9]{2}-REL-[0-9]{4}$" },
    "notes": { "type": "string", "maxLength": 8000 }
  }
}
