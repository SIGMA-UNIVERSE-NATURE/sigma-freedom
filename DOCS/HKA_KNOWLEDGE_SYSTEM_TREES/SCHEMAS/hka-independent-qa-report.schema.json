{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hka.sigmastudy.net/schemas/hka-independent-qa-report.schema.json",
  "title": "HKA Independent QA Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "run_id",
    "prompt_commit_sha",
    "manifest_sha256",
    "batch_package_sha256",
    "reviewer_window",
    "reviewed_at",
    "asset_results",
    "severity_totals",
    "overall_status"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "batch_id": { "type": "string", "pattern": "^HKA-W[0-9]{2}-B[0-9]{2}$" },
    "run_id": { "type": "string", "pattern": "^HKA-W[0-9]{2}-B[0-9]{2}-R[0-9]{2}$" },
    "prompt_commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "batch_package_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewer_window": { "type": "string", "pattern": "^QA-W[0-9]{2}-HKA-W[0-9]{2}-B[0-9]{2}-R[0-9]{2}$" },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "asset_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "clean_master_sha256",
          "branded_final_sha256",
          "academic_gate",
          "pedagogy_gate",
          "visual_gate",
          "character_brand_gate",
          "accessibility_gate",
          "integrity_gate",
          "issues",
          "status"
        ],
        "properties": {
          "asset_id": { "type": "string", "pattern": "^HKA-VIS-W[0-9]{2}-[0-9]{4}$" },
          "clean_master_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "branded_final_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "academic_gate": { "$ref": "#/$defs/gateResult" },
          "pedagogy_gate": { "$ref": "#/$defs/gateResult" },
          "visual_gate": { "$ref": "#/$defs/gateResult" },
          "character_brand_gate": { "$ref": "#/$defs/gateResult" },
          "accessibility_gate": { "$ref": "#/$defs/gateResult" },
          "integrity_gate": { "$ref": "#/$defs/gateResult" },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["severity", "code", "description", "required_action"],
              "properties": {
                "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
                "code": { "type": "string", "pattern": "^[A-Z0-9_-]{3,50}$" },
                "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
                "evidence": { "type": "string", "maxLength": 4000 },
                "required_action": { "type": "string", "minLength": 1, "maxLength": 4000 }
              }
            }
          },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED"] }
        }
      }
    },
    "severity_totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["P0", "P1", "P2", "P3"],
      "properties": {
        "P0": { "type": "integer", "minimum": 0 },
        "P1": { "type": "integer", "minimum": 0 },
        "P2": { "type": "integer", "minimum": 0 },
        "P3": { "type": "integer", "minimum": 0 }
      }
    },
    "overall_status": { "type": "string", "enum": ["QA_APPROVED", "QA_REJECTED", "QA_BLOCKED"] },
    "summary": { "type": "string", "maxLength": 8000 }
  },
  "$defs": {
    "gateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "notes"],
      "properties": {
        "status": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED"] },
        "notes": { "type": "string", "maxLength": 4000 }
      }
    }
  }
}
