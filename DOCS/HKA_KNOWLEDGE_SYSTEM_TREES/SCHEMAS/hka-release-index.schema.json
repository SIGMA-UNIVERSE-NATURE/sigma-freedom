{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hka.sigmastudy.net/schemas/hka-release-index.schema.json",
  "title": "HKA Knowledge Tree Visual Release Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "window_id",
    "tree_id",
    "tree_slug",
    "package_code",
    "locked_asset_count",
    "released_batch_count",
    "expected_batch_count",
    "batches",
    "overall_status",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "window_id": { "type": "string", "pattern": "^W[0-9]{2}$" },
    "tree_id": { "type": "string", "minLength": 5, "maxLength": 100 },
    "tree_slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "package_code": { "type": "string", "enum": ["P12", "P18", "P24", "P30", "P36"] },
    "locked_asset_count": { "type": "integer", "enum": [12, 18, 24, 30, 36] },
    "released_batch_count": { "type": "integer", "minimum": 0, "maximum": 7 },
    "expected_batch_count": { "type": "integer", "minimum": 3, "maximum": 7 },
    "batches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "batch_id",
          "run_id",
          "release_id",
          "prompt_commit_sha",
          "manifest_sha256",
          "batch_package_sha256",
          "qa_report_sha256",
          "r2_upload_receipt_sha256",
          "r2_release_audit_record_sha256",
          "vault_prefix",
          "asset_count",
          "status"
        ],
        "properties": {
          "batch_id": { "type": "string", "pattern": "^HKA-W[0-9]{2}-B[0-9]{2}$" },
          "run_id": { "type": "string", "pattern": "^HKA-W[0-9]{2}-B[0-9]{2}-R[0-9]{2}$" },
          "release_id": { "type": "string", "pattern": "^HKA-W[0-9]{2}-REL-[0-9]{4}$" },
          "prompt_commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "batch_package_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "qa_report_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "r2_upload_receipt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "r2_release_audit_record_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "vault_prefix": {
            "type": "string",
            "pattern": "^v1/windows/W[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*/prompt-commit/[a-f0-9]{40}/batches/HKA-W[0-9]{2}-B[0-9]{2}/runs/HKA-W[0-9]{2}-B[0-9]{2}-R[0-9]{2}/$"
          },
          "asset_count": { "type": "integer", "minimum": 1, "maximum": 6 },
          "status": { "type": "string", "enum": ["R2_VERIFIED", "WEB_APPROVED", "PUBLISHED", "SUPERSEDED", "REVOKED"] }
        }
      }
    },
    "overall_status": {
      "type": "string",
      "enum": ["IN_PROGRESS", "R2_COMPLETE", "WEB_APPROVED", "PUBLISHED", "SUPERSEDED", "REVOKED"]
    },
    "updated_at": { "type": "string", "format": "date-time" },
    "notes": { "type": "string", "maxLength": 8000 }
  }
}
