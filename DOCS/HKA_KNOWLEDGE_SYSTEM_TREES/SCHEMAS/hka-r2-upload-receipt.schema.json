{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hka.sigmastudy.net/schemas/hka-r2-upload-receipt.schema.json",
  "title": "HKA R2 Upload Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "batch_id",
    "run_id",
    "prompt_commit_sha",
    "manifest_sha256",
    "batch_package_sha256",
    "qa_report_sha256",
    "qa_status",
    "r2_bucket",
    "r2_prefix",
    "expected_object_count",
    "verified_object_count",
    "objects",
    "checksums_verified",
    "release_marker_written",
    "prefix_lock_applied",
    "uploaded_at",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "release_id": { "type": "string", "pattern": "^HKA-W[0-9]{2}-REL-[0-9]{4}$" },
    "batch_id": { "type": "string", "pattern": "^HKA-W[0-9]{2}-B[0-9]{2}$" },
    "run_id": { "type": "string", "pattern": "^HKA-W[0-9]{2}-B[0-9]{2}-R[0-9]{2}$" },
    "prompt_commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "batch_package_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "qa_report_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "qa_status": { "const": "QA_APPROVED" },
    "r2_bucket": { "const": "hka-c4k-vault" },
    "r2_prefix": {
      "type": "string",
      "pattern": "^v1/windows/W[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*/prompt-commit/[a-f0-9]{40}/batches/HKA-W[0-9]{2}-B[0-9]{2}/runs/HKA-W[0-9]{2}-B[0-9]{2}-R[0-9]{2}/$"
    },
    "expected_object_count": { "type": "integer", "minimum": 1 },
    "verified_object_count": { "type": "integer", "minimum": 1 },
    "objects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_key",
          "content_type",
          "content_length",
          "sha256",
          "etag",
          "metadata_verified"
        ],
        "properties": {
          "object_key": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "asset_id": { "type": "string", "pattern": "^HKA-VIS-W[0-9]{2}-[0-9]{4}$" },
          "variant": { "type": "string", "enum": ["CLEAN_MASTER", "BRANDED_FINAL", "METADATA", "MANIFEST", "PROMPT", "REPORT", "CHECKSUM", "PACKAGE", "RECEIPT", "RELEASE_MARKER"] },
          "content_type": { "type": "string", "minLength": 3, "maxLength": 120 },
          "content_length": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "etag": { "type": "string", "minLength": 1, "maxLength": 256 },
          "metadata_verified": { "type": "boolean" }
        }
      }
    },
    "checksums_verified": { "const": true },
    "release_marker_written": { "const": true },
    "prefix_lock_applied": { "const": true },
    "uploaded_at": { "type": "string", "format": "date-time" },
    "status": { "const": "R2_VERIFIED" },
    "notes": { "type": "string", "maxLength": 8000 }
  }
}
