{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hka.sigmastudy.net/schemas/hka-production-status.schema.json",
  "title": "HKA Production Status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "run_id",
    "prompt_commit_sha",
    "manifest_sha256",
    "status",
    "asset_total",
    "asset_completed",
    "asset_passed_self_qa",
    "asset_failed_self_qa",
    "blocked_asset_ids",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "batch_id": { "type": "string", "pattern": "^HKA-W[0-9]{2}-B[0-9]{2}$" },
    "run_id": { "type": "string", "pattern": "^HKA-W[0-9]{2}-B[0-9]{2}-R[0-9]{2}$" },
    "prompt_commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": {
      "type": "string",
      "enum": [
        "BATCH_READY",
        "PRODUCTION_CLAIMED",
        "PRODUCING",
        "PROMPT_BLOCKED",
        "SELF_QA",
        "SELF_QA_COMPLETE",
        "QA_REVIEW",
        "QA_REJECTED",
        "QA_BLOCKED",
        "QA_APPROVED",
        "R2_UPLOAD_AUTHORIZED",
        "UPLOADING",
        "R2_VERIFYING",
        "R2_FAILED",
        "R2_VERIFIED",
        "RELEASED",
        "WEB_APPROVED",
        "PUBLISHED"
      ]
    },
    "asset_total": { "type": "integer", "minimum": 1, "maximum": 6 },
    "asset_completed": { "type": "integer", "minimum": 0, "maximum": 6 },
    "asset_passed_self_qa": { "type": "integer", "minimum": 0, "maximum": 6 },
    "asset_failed_self_qa": { "type": "integer", "minimum": 0, "maximum": 6 },
    "blocked_asset_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^HKA-VIS-W[0-9]{2}-[0-9]{4}$" }
    },
    "notes": { "type": "string", "maxLength": 4000 },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
