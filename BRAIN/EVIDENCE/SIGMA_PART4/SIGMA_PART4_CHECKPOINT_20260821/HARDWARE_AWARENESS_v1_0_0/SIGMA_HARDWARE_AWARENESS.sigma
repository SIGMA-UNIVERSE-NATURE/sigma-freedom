#SIGMAUNIVERSE_LANGUAGE[DOMAIN=HARDWARE_AWARENESS][VERSION=1.0.0]

⟡(Σ.HARDWAREAWAREMANIFEST) {
  ⚡ MODULE: "HARDWARE_AWARENESS";
  ⚡ VERSION: "1.0.0";
  ⚡ STATE: "SENSING";
  ⚡ SENSOR_INTERVAL: 30;
  ⚡ CRITICAL_TEMP: 65;
  ⚡ LOW_BATTERY: 15;
  ⚡ MIN_RAM: 500;

  // =========================================================================
  // BỔ SUNG KỸ THUẬT - KHÔNG THAY ĐỔI NỘI DUNG GỐC
  // =========================================================================
  ⚡ SENSOR_EVIDENCE_MODE: "REAL_HOST_OBSERVATION_ONLY";
  ⚡ DEMO_DATA_STATUS: "SIMULATED";
  ⚡ REAL_HARDWARE_STATUS: "NOT_YET_MACHINE_PROVED";
  ⚡ REAL_MONITOR_LOOP_STATUS: "NOT_YET_MACHINE_PROVED";

  ⚡ CPU_TEMP_SOURCE: "/sys/class/thermal/thermal_zone*/temp";
  ⚡ BATTERY_SOURCE: "termux-battery-status";
  ⚡ RAM_SOURCE: "/proc/meminfo";
  ⚡ STORAGE_SOURCE: "df_-k";
  ⚡ NETWORK_SOURCE: "ping_-c_1_-W_2_google.com";
  ⚡ UPTIME_SOURCE: "/proc/uptime";

  ⚡ SENSOR_DISCOVERY: "CAPABILITY_DETECTION_BEFORE_READ";
  ⚡ SENSOR_PROVENANCE_REQUIRED: "TRUE";
  ⚡ SENSOR_TIMESTAMP_REQUIRED: "TRUE";
  ⚡ SENSOR_UNAVAILABLE_POLICY: "UNKNOWN_NOT_SIMULATED";
  ⚡ PING_FAILURE_POLICY: "UNKNOWN_NOT_ZERO";

  ⚡ MIN_RAM_UNIT: "MB";
  ⚡ STORAGE_CRITICAL_THRESHOLD_MB: 500;

  ⚡ EVOLUTION_HEALTH_GATE: "REAL_OBSERVATION_REQUIRED";
  ⚡ CRITICAL_RESPONSE: "EMERGENCY_SNAPSHOT_AND_SUSPEND";
  ⚡ WARNING_RESPONSE: "THROTTLE_EVOLUTION";
  ⚡ GOOD_RESPONSE: "NORMAL";

  ⚡ EMERGENCY_SNAPSHOT_REQUIRED: "TRUE";
  ⚡ FAIL_CLOSED_ON_UNKNOWN_CRITICAL_SENSOR: "TRUE";
  ⚡ PRIVILEGE_ESCALATION: "FORBIDDEN";
  ⚡ LOG_MODE: "APPEND_ONLY";
  ⚡ LOG_PROVENANCE_REQUIRED: "TRUE";

  ⚡ TEMPORARY_SUBSTRATE_BRIDGE: "ALLOWED_UNTIL_SIGMA_NATIVE";
  ⚡ SIGMA_NATIVE_SENSOR_INTEGRATION: "REQUIRED_WHEN_READY";
  ⚡ GOVERNING_BOUNDARY: "TAM_VAN_TU_BI";
}

⟡(Σ.HARDWAREAWAREENGINE) {

  // =========================================================================
  // 5.1. ĐỌC THÔNG TIN PHẦN CỨNG THỰC TẾ
  // =========================================================================
  ⚡ READ_HARDWARE_STATUS: "Đọc thông tin phần cứng thực tế: cpu_temp_c từ /sys/class/thermal/thermal_zone0/temp, battery_percent và battery_status từ termux-battery-status, ram_total_mb và ram_available_mb từ /proc/meminfo, storage_total_mb và storage_used_mb từ df -k, ping_ms từ ping -c 1 -W 2 google.com, uptime_hours từ /proc/uptime, trả về hardware object với timestamp";

  // =========================================================================
  // 5.2. ĐÁNH GIÁ TÌNH TRẠNG PHẦN CỨNG
  // =========================================================================
  ⚡ ASSESS_HARDWARE_HEALTH: "Đánh giá tình trạng phần cứng: kiểm tra cpu_temp_c > CRITICAL_TEMP thì thêm critical_issues, battery_percent < LOW_BATTERY thì thêm critical_issues, ram_available_mb < MIN_RAM thì thêm critical_issues, storage_avail_mb < 500 thì thêm critical_issues, ping_ms > 200 thì thêm warnings, nếu có critical_issues thì overall = CRITICAL và can_evolve = false, nếu chỉ có warnings thì overall = WARNING, nếu không có gì thì overall = GOOD, trả về health object";

  // =========================================================================
  // 5.3. TỰ ĐỘNG PHẢN HỒI THEO TÌNH TRẠNG PHẦN CỨNG
  // =========================================================================
  ⚡ HARDWARE_AUTO_RESPONSE: "Tự động phản hồi theo health: nếu overall == CRITICAL thì in cảnh báo, tạo EMERGENCY_SAVE_AT_CRITICAL snapshot, sleep(300), return SUSPENDED; nếu overall == WARNING thì in cảnh báo, set_evolution_pace(SLOW), return THROTTLED; nếu overall == GOOD thì in thông tin, return NORMAL";

  // =========================================================================
  // 5.4. VÒNG LẶP GIÁM SÁT PHẦN CỨNG
  // =========================================================================
  ⚡ HARDWARE_MONITOR_LOOP: "Vòng lặp giám sát phần cứng: in header với SENSOR_INTERVAL, CRITICAL_TEMP, LOW_BATTERY, MIN_RAM, while true: read_hardware_status, append_file logs/hardware_status.log với timestamp, cpu_temp, battery, ram_used/total, storage_used/total, assess_hardware_health, hardware_auto_response, sleep(SENSOR_INTERVAL)";

  // =========================================================================
  // 5.5. DEMO
  // =========================================================================
  ⚡ RUN_HARDWARE_AWARENESS_DEMO: "Chạy demo: read_hardware_status và in tất cả thông số, assess_hardware_health và in overall, warnings, critical_issues, hardware_auto_response và in response status, in tổng kết";

  // =========================================================================
  // 5.6. MÔ PHỎNG KẾT QUẢ DEMO
  // =========================================================================
  ⚡ CPU_TEMP_SIM: 42.5;
  ⚡ BATTERY_SIM: 67;
  ⚡ BATTERY_STATUS_SIM: "CHARGING";
  ⚡ RAM_TOTAL_SIM: 3800;
  ⚡ RAM_USED_SIM: 2100;
  ⚡ RAM_AVAIL_SIM: 1700;
  ⚡ RAM_USAGE_SIM: 55.2;
  ⚡ STORAGE_TOTAL_SIM: 256000;
  ⚡ STORAGE_USED_SIM: 128000;
  ⚡ STORAGE_AVAIL_SIM: 128000;
  ⚡ STORAGE_USAGE_SIM: 50.0;
  ⚡ PING_SIM: 12.3;
  ⚡ UPTIME_SIM: 48.5;
  ⚡ OVERALL_HEALTH: "GOOD";
  ⚡ CAN_EVOLVE: "TRUE";
  ⚡ WARNINGS_COUNT: 0;
  ⚡ CRITICAL_COUNT: 0;
  ⚡ RESPONSE_STATUS: "NORMAL";

  ⚡ print("==================================================");
  ⚡ print("  🖥️ SIGMA HARDWARE AWARENESS ENGINE             ");
  ⚡ print("==================================================");
  ⚡ print("");

  ⚡ print("[1] Đọc thông tin phần cứng hiện tại...");
  ⚡ print("   📊 Hardware Status:");
  ⚡ print("   • CPU Temperature: " + str(CPU_TEMP_SIM) + "°C");
  ⚡ print("   • Battery: " + str(BATTERY_SIM) + "% (" + BATTERY_STATUS_SIM + ")");
  ⚡ print("   • RAM: " + str(RAM_USED_SIM) + "MB / " + str(RAM_TOTAL_SIM) + "MB");
  ⚡ print("   • RAM Usage: " + str(RAM_USAGE_SIM) + "%");
  ⚡ print("   • Storage: " + str(STORAGE_USED_SIM) + "MB / " + str(STORAGE_TOTAL_SIM) + "MB");
  ⚡ print("   • Storage Usage: " + str(STORAGE_USAGE_SIM) + "%");
  ⚡ print("   • Ping: " + str(PING_SIM) + "ms");
  ⚡ print("   • Uptime: " + str(UPTIME_SIM) + " hours");

  ⚡ print("");
  ⚡ print("[2] Đánh giá sức khỏe phần cứng...");
  ⚡ print("   • Overall Health: " + OVERALL_HEALTH);
  ⚡ print("   • Can Evolve: " + CAN_EVOLVE);

  ⚡ print("");
  ⚡ print("[3] Phản hồi tự động...");
  ⚡ print("✅ Phần cứng đang ở trạng thái tốt.");
  ⚡ print("   • CPU Temp: " + str(CPU_TEMP_SIM) + "°C");
  ⚡ print("   • Battery: " + str(BATTERY_SIM) + "%");
  ⚡ print("   • RAM Available: " + str(RAM_AVAIL_SIM) + " MB");
  ⚡ print("   • Storage Available: " + str(STORAGE_AVAIL_SIM) + " MB");
  ⚡ print("   • Response Status: " + RESPONSE_STATUS);

  ⚡ print("");
  ⚡ print("==================================================");
  ⚡ print("✅ HARDWARE AWARENESS DEMO HOÀN TẤT");
  ⚡ print("   • Health: " + OVERALL_HEALTH);
  ⚡ print("   • Can evolve: " + CAN_EVOLVE);
  ⚡ print("   • Warnings: " + str(WARNINGS_COUNT));
  ⚡ print("   • Critical issues: " + str(CRITICAL_COUNT));

  ⚡ print("");
  ⚡ print("=== REAL HARDWARE AWARENESS CONTRACT ===");
  ⚡ print(SENSOR_EVIDENCE_MODE);
  ⚡ print(DEMO_DATA_STATUS);
  ⚡ print(REAL_HARDWARE_STATUS);
  ⚡ print(REAL_MONITOR_LOOP_STATUS);
  ⚡ print(SENSOR_DISCOVERY);
  ⚡ print(SENSOR_UNAVAILABLE_POLICY);
  ⚡ print(EVOLUTION_HEALTH_GATE);
  ⚡ print(FAIL_CLOSED_ON_UNKNOWN_CRITICAL_SENSOR);
  ⚡ print(SIGMA_NATIVE_SENSOR_INTEGRATION);
  ⚡ print(GOVERNING_BOUNDARY);
  ⚡ print("==================================================");
}
