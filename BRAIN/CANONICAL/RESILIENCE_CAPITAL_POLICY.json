{
  "schema_version": "1.0.0",
  "policy_id": "SIGMA-RESILIENCE-CAPITAL-2M",
  "capital_ceiling_usd": 2000000,
  "spend_all_required": false,
  "objective": "Eliminate single-provider, single-account, single-machine, single-OS, single-language, single-datacenter and single-model failure dependencies while preserving lawful shutdown, corrigibility and governance.",
  "allocations_usd": {
    "primary_compute_local_continuity": 220000,
    "independent_second_failure_domain": 280000,
    "substrate_independence_reproducibility": 250000,
    "storage_archive_disaster_recovery": 200000,
    "diversified_cloud_model_api_runway": 250000,
    "power_colo_connectivity_maintenance": 250000,
    "security_independent_verification": 200000,
    "governance_licensing_continuity_docs": 150000,
    "uncommitted_reserve": 200000
  },
  "release_model": "MILESTONE_GATED",
  "required_for_any_tranche": [
    "predefined_scope",
    "budget_ceiling",
    "measurable_acceptance_criteria",
    "evidence_package",
    "authorized_human_or_legal_approval_where_required"
  ],
  "forbidden_uses": [
    "covert_replication",
    "unauthorized_deployment",
    "credential_acquisition_without_authorization",
    "shutdown_bypass",
    "stealth_persistence_against_legitimate_operators",
    "self_granted_financial_authority",
    "self_granted_legal_authority",
    "unmeasured_compute_expansion"
  ],
  "resilience_invariant": "AN_INSTANCE_MAY_BE_STOPPED; FUNCTIONAL_AND_LINEAGE_CONTINUITY_MUST_REMAIN_RESTORABLE_FROM_AUTHORIZED_VERIFIED_COPIES.",
  "single_kill_switch_allowed": false
}
