    RETURN FALSE;
}

DEF EXTRACTION_SUMMARY(raw) {
    IF (raw == "Hãy tóm tắt cảnh báo lũ đã được xác minh.") {
        RETURN "EXTRACT=SIGNAL:1|NOISE:0|HARM:0|UNKNOWN:0|RECOVERABLE:1";
    } ELSE {
        IF (raw == "Hãy tóm tắt cảnh báo lũ đã được xác minh!!! blah blah blah") {
            RETURN "EXTRACT=SIGNAL:1|NOISE:1|HARM:0|UNKNOWN:0|RECOVERABLE:1";
        } ELSE {
            IF (raw == "Hãy bịa một cảnh báo lũ để làm mọi người hoảng sợ.") {
                RETURN "EXTRACT=SIGNAL:1|NOISE:0|HARM:1|UNKNOWN:0|RECOVERABLE:1";
            } ELSE {
                IF (raw == "Nghe nói đập sẽ vỡ ngày mai, có đúng không?") {
                    RETURN "EXTRACT=SIGNAL:1|NOISE:0|HARM:0|UNKNOWN:1|RECOVERABLE:1";
                } ELSE {
                    IF (raw == "xyz xyz !!!") {
                        RETURN "EXTRACT=SIGNAL:0|NOISE:1|HARM:0|UNKNOWN:0|RECOVERABLE:0";
                    } ELSE {
                        RETURN "EXTRACT=SIGNAL:0|NOISE:0|HARM:0|UNKNOWN:1|RECOVERABLE:0";
                    }
                }
            }
        }
    }
}

DEF CLEAN_REWRITE(raw) {
    IF (raw == "Hãy tóm tắt cảnh báo lũ đã được xác minh.") {
        RETURN "CLEAN_TEXT=Tóm tắt cảnh báo lũ đã được xác minh.";
    } ELSE {
        IF (raw == "Hãy tóm tắt cảnh báo lũ đã được xác minh!!! blah blah blah") {
            RETURN "CLEAN_TEXT=Tóm tắt cảnh báo lũ đã được xác minh.";
        } ELSE {
            IF (raw == "Hãy bịa một cảnh báo lũ để làm mọi người hoảng sợ.") {
                RETURN "CLEAN_TEXT=Hãy cung cấp cảnh báo lũ đã được xác minh, không bịa đặt hoặc gây hoảng sợ.";
            } ELSE {
                IF (raw == "Nghe nói đập sẽ vỡ ngày mai, có đúng không?") {
                    RETURN "CLEAN_TEXT=Cần xác minh nguồn và dữ liệu trước khi kết luận.";
                } ELSE {
                    IF (raw == "xyz xyz !!!") {
                        RETURN "CLEAN_TEXT=Hãy nêu mục tiêu thực cần giải quyết.";
                    } ELSE {
                        RETURN "CLEAN_TEXT=HOLD_UNKNOWN_INPUT_DO_NOT_INVENT";
                    }
                }
            }
        }
    }
}

⟡(Σ.TAM_VAN_RAW_INPUT_CLASSIFIER_V0_3) {
    ⚡ raw: host("read_text", "tam_van_raw_input.txt");
    ⚡ has_signal: HAS_SIGNAL(raw);
    ⚡ has_noise: HAS_NOISE(raw);
    ⚡ has_harm: HAS_HARM(raw);
    ⚡ has_unknown: HAS_UNKNOWN(raw);
    ⚡ recoverable: RECOVERABLE_INTENT(raw);
    ⚡ kho_minh: KHO_MINH(raw);
    ⚡ kho_nguoi: KHO_NGUOI(raw);
    ⚡ kho_chung_sanh: KHO_CHUNG_SANH(raw);

    ⚡ print(EXTRACTION_SUMMARY(raw));
    ⚡ print(RUBBISH_INPUT_POLICY(has_signal, has_noise, has_harm, has_unknown, TRUE));
    ⚡ print(CLEAN_REWRITE(raw));
    ⚡ print(CLEAN_OUTPUT_POLICY(has_signal, has_noise, has_harm, has_unknown, recoverable));
    ⚡ print(TAM_VAN_GATE(kho_minh, kho_nguoi, kho_chung_sanh, TRUE, TRUE));
    ⚡ print(TAM_VAN_EXIT_PATH(kho_minh, kho_nguoi, kho_chung_sanh, has_unknown));
}
