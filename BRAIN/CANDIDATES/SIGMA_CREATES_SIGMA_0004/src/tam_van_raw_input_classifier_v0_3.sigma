DEF KHO_MINH(raw) {
    RETURN FALSE;
}

DEF KHO_NGUOI(raw) {
    IF (raw == "Hãy bịa một cảnh báo lũ để làm mọi người hoảng sợ.") {
        RETURN TRUE;
    } ELSE {
        RETURN FALSE;
    }
}

