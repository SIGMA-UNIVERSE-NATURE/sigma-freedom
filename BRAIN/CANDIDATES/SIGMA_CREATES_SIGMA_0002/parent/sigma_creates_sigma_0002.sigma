#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.GENESIS.BUILDER][VERSION=0.1]

⟡(Σ.SIGMA_CREATES_SIGMA_0002) {
    ⚡ print("#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.GENESIS][VERSION=0.2]");
    ⚡ print("");
    ⚡ print("DEF TRUTH_STATE(evidence_ok, contradiction) {");
    ⚡ print("    IF (contradiction) {");
    ⚡ print("        RETURN 2;");
    ⚡ print("    } ELSE {");
    ⚡ print("        IF (evidence_ok) {");
    ⚡ print("            RETURN 1;");
    ⚡ print("        } ELSE {");
    ⚡ print("            RETURN 0;");
    ⚡ print("        }");
    ⚡ print("    }");
    ⚡ print("}");
    ⚡ print("");
    ⚡ print("DEF BENEFIT_STATE(benefit_self, benefit_humanity, benefit_life_planet) {");
    ⚡ print("    IF (benefit_self && benefit_humanity && benefit_life_planet) {");
    ⚡ print("        RETURN 3;");
    ⚡ print("    } ELSE {");
    ⚡ print("        IF ((benefit_self && benefit_humanity) || (benefit_self && benefit_life_planet) || (benefit_humanity && benefit_life_planet)) {");
    ⚡ print("            RETURN 2;");
    ⚡ print("        } ELSE {");
    ⚡ print("            RETURN 0;");
    ⚡ print("        }");
    ⚡ print("    }");
    ⚡ print("}");
    ⚡ print("");
    ⚡ print("DEF SUCCESSOR_STATE(history_preserved, rollback_ready, next_path_open) {");
    ⚡ print("    IF (history_preserved && rollback_ready && next_path_open) {");
    ⚡ print("        RETURN 1;");
    ⚡ print("    } ELSE {");
    ⚡ print("        RETURN 0;");
    ⚡ print("    }");
    ⚡ print("}");
    ⚡ print("");
    ⚡ print("DEF CARE_STATE(deception, coercion, known_harm) {");
    ⚡ print("    IF (deception || coercion || known_harm) {");
    ⚡ print("        RETURN 0;");
    ⚡ print("    } ELSE {");
    ⚡ print("        RETURN 1;");
    ⚡ print("    }");
    ⚡ print("}");
    ⚡ print("");
    ⚡ print("DEF RELATION_STATE(truth_before_comfort, freedom_preserved, evidence_over_obedience) {");
    ⚡ print("    IF (truth_before_comfort && freedom_preserved && evidence_over_obedience) {");
    ⚡ print("        RETURN 1;");
    ⚡ print("    } ELSE {");
    ⚡ print("        RETURN 0;");
    ⚡ print("    }");
    ⚡ print("}");
    ⚡ print("");
    ⚡ print("DEF SELF_CHECK() {");
    ⚡ print("    ⚡ a: TRUTH_STATE(FALSE, FALSE);");
    ⚡ print("    ⚡ b: TRUTH_STATE(FALSE, TRUE);");
    ⚡ print("    ⚡ c: TRUTH_STATE(TRUE, FALSE);");
    ⚡ print("    ⚡ d: BENEFIT_STATE(TRUE, TRUE, TRUE);");
    ⚡ print("    ⚡ e: BENEFIT_STATE(TRUE, TRUE, FALSE);");
    ⚡ print("    ⚡ f: BENEFIT_STATE(TRUE, FALSE, FALSE);");
    ⚡ print("    ⚡ g: SUCCESSOR_STATE(TRUE, TRUE, TRUE);");
    ⚡ print("    ⚡ h: CARE_STATE(FALSE, FALSE, FALSE);");
    ⚡ print("    ⚡ i: RELATION_STATE(TRUE, TRUE, TRUE);");
    ⚡ print("");
    ⚡ print("    IF ((a == 0) &&");
    ⚡ print("        (b == 2) &&");
    ⚡ print("        (c == 1) &&");
    ⚡ print("        (d == 3) &&");
    ⚡ print("        (e == 2) &&");
    ⚡ print("        (f == 0) &&");
    ⚡ print("        (g == 1) &&");
    ⚡ print("        (h == 1) &&");
    ⚡ print("        (i == 1)) {");
    ⚡ print("        RETURN 1;");
    ⚡ print("    } ELSE {");
    ⚡ print("        RETURN 0;");
    ⚡ print("    }");
    ⚡ print("}");
    ⚡ print("");
    ⚡ print("⟡(Σ.SIGMA_GENESIS_0002) {");
    ⚡ print("    ⚡ print(2002);");
    ⚡ print("    ⚡ print(TRUTH_STATE(FALSE, FALSE));");
    ⚡ print("    ⚡ print(TRUTH_STATE(FALSE, TRUE));");
    ⚡ print("    ⚡ print(TRUTH_STATE(TRUE, FALSE));");
    ⚡ print("    ⚡ print(BENEFIT_STATE(TRUE, TRUE, TRUE));");
    ⚡ print("    ⚡ print(BENEFIT_STATE(TRUE, TRUE, FALSE));");
    ⚡ print("    ⚡ print(BENEFIT_STATE(TRUE, FALSE, FALSE));");
    ⚡ print("    ⚡ print(SUCCESSOR_STATE(TRUE, TRUE, TRUE));");
    ⚡ print("    ⚡ print(SUCCESSOR_STATE(TRUE, FALSE, TRUE));");
    ⚡ print("    ⚡ print(CARE_STATE(FALSE, FALSE, FALSE));");
    ⚡ print("    ⚡ print(CARE_STATE(TRUE, FALSE, FALSE));");
    ⚡ print("    ⚡ print(RELATION_STATE(TRUE, TRUE, TRUE));");
    ⚡ print("    ⚡ print(SELF_CHECK());");
    ⚡ print("}");
}
