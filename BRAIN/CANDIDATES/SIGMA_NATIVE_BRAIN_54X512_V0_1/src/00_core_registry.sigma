DEF CORE_NAME(core_id) {
    IF ((core_id < 1) || (core_id > 54)) {
        RETURN "INVALID_CORE_ID";
    } ELSE {
        ⚡ names: CORE_NAMES();
        RETURN LGET(names, core_id - 1);
    }
}

