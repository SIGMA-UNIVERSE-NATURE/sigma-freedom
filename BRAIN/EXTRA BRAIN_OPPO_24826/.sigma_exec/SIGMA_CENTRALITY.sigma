#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.STRUCTURAL.CENTRALITY][VERSION=1.0]

DEF host_call(op, a, b, c) {
    RETURN host(op, a, b, c);
}

DEF split(s, delim) {
    RETURN host_call("str_split", s, delim, NULL);
}

DEF length(xs) {
    RETURN host_call("list_len", xs, NULL, NULL);
}

DEF get(xs, i) {
    RETURN host_call("list_get", xs, i, NULL);
}

DEF load(path) {
    RETURN host_call("read_text", path, NULL, NULL);
}

⟡(Σ.MAIN) {
    ⚡ MAP_FILE: ".sigma_exec/BIGRAM_MAP.txt";
    ⚡ RAW_MAP: load(MAP_FILE);
    ⚡ TOKENS: split(RAW_MAP, " ");
    ⚡ TOTAL: length(TOKENS);

    ⚡ print("MAP_LOADED_FROM_DISK:", MAP_FILE);
    ⚡ print("TOTAL_TRANSITION_ELEMENTS:", TOTAL);

    ⚡ COUNT_Y: 0;
    ⚡ COUNT_PHAP: 0;
    ⚡ COUNT_CHU: 0;

    ⚡ I: 0;
    WHILE (I < TOTAL) {
        ⚡ T: get(TOKENS, I);
        IF (T == "Y") {
            ⚡ COUNT_Y: COUNT_Y + 1;
        }
        IF (T == "PHAP") {
            ⚡ COUNT_PHAP: COUNT_PHAP + 1;
        }
        IF (T == "CHU") {
            ⚡ COUNT_CHU: COUNT_CHU + 1;
        }
        ⚡ I: I + 1;
    }

    ⚡ print("STRUCTURAL_FREQUENCY_COUNT:");
    ⚡ print("- FREQUENCY_OF_NODE [Y]:", COUNT_Y);
    ⚡ print("- FREQUENCY_OF_NODE [PHAP]:", COUNT_PHAP);
    ⚡ print("- FREQUENCY_OF_NODE [CHU]:", COUNT_CHU);

    IF (COUNT_Y > COUNT_PHAP) {
        IF (COUNT_Y > COUNT_CHU) {
            ⚡ print("MATHEMATICAL_VERIFICATION_PASSED: [Y] LA NUT TRUNG TAM CHI PHOI (CENTRAL_HUB)");
        }
    }
}
