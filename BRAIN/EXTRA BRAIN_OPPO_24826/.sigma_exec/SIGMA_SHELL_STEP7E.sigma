#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.SHELL][VERSION=0.5]

⟡(Σ.SHELL) {

    ⚡ FIRST:
        host("input","Σ1> ",NULL,NULL);

    ⚡ SECOND:
        host("input","Σ2> ",NULL,NULL);

    ⚡ RESULT:
        FIRST + SECOND;

    ⚡ STORED_RESULT:
        RESULT;

    ⚡ READ_BACK:
        STORED_RESULT;

    print(FIRST);
    print(SECOND);
    print(RESULT);
    print(STORED_RESULT);
    print(READ_BACK);
}
