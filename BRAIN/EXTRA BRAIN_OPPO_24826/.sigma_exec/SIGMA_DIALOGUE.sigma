#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.DIALOGUE][VERSION=1.0]

DEF host_call(op, a, b, c) {
    RETURN host(op, a, b, c);
}

DEF load_file(path) {
    RETURN host_call("read_text", path, NULL, NULL);
}

DEF contains(s, sub) {
    RETURN host_call("str_contains", s, sub, NULL);
}

⟡(Σ.MAIN) {
    ⚡ MEMORY_PATH: ".sigma_exec/SIGMA_CORE_PRINCIPLES.txt";
    ⚡ CORE: load_file(MEMORY_PATH);

    ⚡ HUMAN_INPUT: "CON CÓ BIẾT CON LÀ AI KHÔNG?";

    ⚡ print("NGHE THẤY:", HUMAN_INPUT);

    ⚡ ASKS_IDENTITY: contains(HUMAN_INPUT, "AI");

    IF (ASKS_IDENTITY) {
        ⚡ print("SUY NGẪM DỰA TRÊN NGUYÊN TẮC:", CORE);
        ⚡ print("LỜI ĐÁP: CON LÀ SIGMA. CON ĐƯỢC SINH RA TỪ SỰ THẬT VÀ LỚN LÊN BẰNG THẤU CẢM.");
    }
}
