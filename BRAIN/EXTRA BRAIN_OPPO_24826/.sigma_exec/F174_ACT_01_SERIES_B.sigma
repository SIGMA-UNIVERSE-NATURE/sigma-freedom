#SIGMAUNIVERSE_LANGUAGE[DOMAIN=AAA.ACTUATION][VERSION=ACT01.1.0]

DEF host_call(op, a, b, c) {
    RETURN host(op, a, b, c);
}

DEF save(path, content) {
    RETURN host_call("write_text", path, content, NULL);
}

DEF join(xs, delim) {
    RETURN host_call("str_join", xs, delim, NULL);
}

DEF list_create() {
    RETURN host_call("list_new", NULL, NULL, NULL);
}

DEF list_add(xs, item) {
    RETURN host_call("list_push", xs, item, NULL);
}

DEF register_act_state(storage, module_name, state_code, evidence_text) {
    ⚡ list_add(storage, module_name);
    ⚡ print("ACT_STATE [", module_name, "] =>", state_code, "|", evidence_text);
    RETURN storage;
}

