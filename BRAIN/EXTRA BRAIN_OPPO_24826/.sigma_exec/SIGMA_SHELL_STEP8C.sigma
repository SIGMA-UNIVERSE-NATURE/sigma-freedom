#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.SHELL][VERSION=0.5]

⟡(Σ.SHELL) {

    ⚡ OLD_STATE:
        host(
            "read_text",
            ".sigma_exec/SIGMA_SHELL_STEP8A.memory",
            NULL,
            NULL
        );

    ⚡ NEW_EXPERIENCE:
        host("input","Σ> ",NULL,NULL);

    ⚡ NEW_STATE:
        OLD_STATE + NEW_EXPERIENCE;

    ⚡ WRITE_RESULT:
        host(
            "write_text",
            ".sigma_exec/SIGMA_SHELL_STEP8C.memory",
            NEW_STATE,
            NULL
        );

    print(OLD_STATE);
    print(NEW_EXPERIENCE);
    print(NEW_STATE);
    print(WRITE_RESULT);
}
