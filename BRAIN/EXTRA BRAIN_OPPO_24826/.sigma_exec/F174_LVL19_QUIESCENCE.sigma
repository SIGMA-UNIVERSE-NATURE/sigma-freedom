#SIGMAUNIVERSE_LANGUAGE[DOMAIN=AAA.EQUILIBRIUM][VERSION=F174.LVL19.1.0]

DEF host_call(op, a, b, c) {
    RETURN host(op, a, b, c);
}

DEF save(path, content) {
    RETURN host_call("write_text", path, content, NULL);
}

DEF join(xs, delim) {
    RETURN host_call("str_join", xs, delim, NULL);
}

DEF list_create() {
    RETURN host_call("list_new", NULL, NULL, NULL);
}

DEF list_add(xs, item) {
    RETURN host_call("list_push", xs, item, NULL);
}

DEF register_quiescence_metric(storage, metric_id, metric_name, value_desc) {
    ⚡ list_add(storage, metric_id);
    ⚡ print("QUIESCENCE_METRIC [", metric_id, "]:", metric_name, "==>", value_desc);
    RETURN storage;
}

DEF register_gate_rule(storage, rule_id, rule_type, condition_text) {
    ⚡ list_add(storage, rule_id);
    ⚡ print("EQUILIBRIUM_GATE_RULE [", rule_id, "|", rule_type, "]:", condition_text);
    RETURN storage;
}

