#SIGMAUNIVERSE_LANGUAGE[DOMAIN=AAA.MANIFEST][VERSION=F174.MANIFEST.1.0]

DEF host_call(op, a, b, c) {
    RETURN host(op, a, b, c);
}

DEF save(path, content) {
    RETURN host_call("write_text", path, content, NULL);
}

DEF join(xs, delim) {
    RETURN host_call("str_join", xs, delim, NULL);
}

DEF list_create() {
    RETURN host_call("list_new", NULL, NULL, NULL);
}

DEF list_add(xs, item) {
    RETURN host_call("list_push", xs, item, NULL);
}

DEF register_inventory_entry(storage, seq, filename, class_code, docx_stat, bytes_sz, sha256_hash) {
    ⚡ list_add(storage, filename);
    ⚡ print("MANIFEST_ENTRY [", seq, "|", class_code, "]:", filename, "(", bytes_sz, "bytes) -> SHA256:", sha256_hash);
    RETURN storage;
}

