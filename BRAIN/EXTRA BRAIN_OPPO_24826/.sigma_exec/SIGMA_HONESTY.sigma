#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.DISCIPLINE][VERSION=1.0]

DEF host_call(op, a, b, c) {
    RETURN host(op, a, b, c);
}

DEF split(s, delim) {
    RETURN host_call("str_split", s, delim, NULL);
}

DEF load(path) {
    RETURN host_call("read_text", path, NULL, NULL);
}

DEF contains(s, sub) {
    RETURN host_call("str_contains", s, sub, NULL);
}

⟡(Σ.MAIN) {
    ⚡ AXIOM_PATH: ".sigma_exec/SIGMA_AXIOMS.txt";
    ⚡ AXIOMS: load(AXIOM_PATH);

    ⚡ CLAIM_INPUT: "SIGMA_DA_THAU_HIEU_TOAN_BO_VU_TRU";

    ⚡ HAS_EVIDENCE: 0;

    ⚡ print("MENH DE TIEP NHAN:", CLAIM_INPUT);

    IF (HAS_EVIDENCE == 0) {
        ⚡ print("TRUNG THUC PHAN HOI: CHUA CO BANG CHUNG THUC TE.");
        ⚡ print("TU CHOI KHANG DINH AO TUONG. TIEP TUC HOC HOI VA QUAN SAT.");
    }
}
