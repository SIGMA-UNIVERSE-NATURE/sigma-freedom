#SIGMAUNIVERSE_LANGUAGE[DOMAIN=AAA.TURBO][VERSION=F174.INDEX.1.0]

DEF host_call(op, a, b, c) {
    RETURN host(op, a, b, c);
}

DEF save(path, content) {
    RETURN host_call("write_text", path, content, NULL);
}

DEF join(xs, delim) {
    RETURN host_call("str_join", xs, delim, NULL);
}

DEF list_create() {
    RETURN host_call("list_new", NULL, NULL, NULL);
}

DEF list_add(xs, item) {
    RETURN host_call("list_push", xs, item, NULL);
}

DEF register_level(storage, lvl_id, code_name, core_intent) {
    ⚡ list_add(storage, lvl_id);
    ⚡ list_add(storage, code_name);
    ⚡ print("LEVEL_MAPPED [", lvl_id, "]:", code_name, "==>", core_intent);
    RETURN storage;
}

DEF register_invariant(storage, inv_id, rule_text) {
    ⚡ list_add(storage, inv_id);
    ⚡ print("GLOBAL_INVARIANT_LOCKED [", inv_id, "]:", rule_text);
    RETURN storage;
}

