#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.LEARNING][VERSION=1.0]

DEF host_call(op, a, b, c) {
    RETURN host(op, a, b, c);
}

DEF split(s, delim) {
    RETURN host_call("str_split", s, delim, NULL);
}

DEF length(xs) {
    RETURN host_call("list_len", xs, NULL, NULL);
}

DEF get(xs, i) {
    RETURN host_call("list_get", xs, i, NULL);
}

⟡(Σ.MAIN) {
    ⚡ RAW: "SIGMA GENESIS NATURAL EVOLUTION";
    ⚡ ITEMS: split(RAW, " ");
    ⚡ TOTAL: length(ITEMS);

    ⚡ print("FOUND_ITEMS", TOTAL);

    ⚡ I: 0;
    WHILE (I < TOTAL) {
        ⚡ VAL: get(ITEMS, I);
        ⚡ print("ITEM", I, VAL);
        ⚡ I: I + 1;
    }
}
