#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.SHELL.ACTION.NEW.OBSERVATION][VERSION=0.1]

DEF H(op,a,b,c){
    RETURN host(op,a,b,c);
}

⟡(Σ.SHELL_ACTION_NEW_OBSERVATION) {

    ⚡ OBSERVATION:
        H("input","",NULL,NULL);


    ⚡ ACTION_RESULT:
        OBSERVATION;


    ⚡ NEW_OBSERVATION:
        ACTION_RESULT;


    ⋈ ACTION {

        ⚡ print(OBSERVATION);

        ⚡ print(NEW_OBSERVATION);

    }

}
