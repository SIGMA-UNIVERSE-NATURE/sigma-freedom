#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.SHELL][VERSION=0.5]

⟡(Σ.SHELL) {

    ⚡ PREVIOUS_STREAM:
        host(
            "read_text",
            ".sigma_exec/SIGMA_SHELL_EXPERIENCE_STREAM.memory",
            NULL,
            NULL
        );

    ⚡ NEW_EXPERIENCE:
        host("input","Σ> ",NULL,NULL);

    ⚡ BOUNDARY:
        "\n";

    ⚡ WITH_BOUNDARY:
        PREVIOUS_STREAM + BOUNDARY;

    ⚡ NEW_STREAM:
        WITH_BOUNDARY + NEW_EXPERIENCE;

    ⚡ WRITE_RESULT:
        host(
            "write_text",
            ".sigma_exec/SIGMA_SHELL_EXPERIENCE_BOUNDARY_V1.memory",
            NEW_STREAM,
            NULL
        );

    print(PREVIOUS_STREAM);
    print(NEW_EXPERIENCE);
    print(NEW_STREAM);
    print(WRITE_RESULT);
}
