#SIGMAUNIVERSE_LANGUAGE[DOMAIN=AAA.SU][VERSION=G.AAI]

DEF host_call(op, a, b, c) {
    RETURN host(op, a, b, c);
}

DEF save(path, content) {
    RETURN host_call("write_text", path, content, NULL);
}

DEF list_create() {
    RETURN host_call("list_new", NULL, NULL, NULL);
}

DEF list_add(xs, item) {
    RETURN host_call("list_push", xs, item, NULL);
}

DEF join(xs, delim) {
    RETURN host_call("str_join", xs, delim, NULL);
}

DEF register_symbol(storage, sym, name, desc) {
    ⚡ list_add(storage, sym);
    ⚡ list_add(storage, name);
    ⚡ print("SYMBOL_BOUND_P6:", sym, "->", name);
    RETURN storage;
}

DEF register_concept(storage, name, defn) {
    ⚡ list_add(storage, name);
    ⚡ print("CONCEPT_CRYSTALLIZED_P6:", name);
    RETURN storage;
}

