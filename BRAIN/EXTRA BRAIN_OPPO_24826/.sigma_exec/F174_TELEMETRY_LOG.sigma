#SIGMAUNIVERSE_LANGUAGE[DOMAIN=AAA.LOG][VERSION=F174.LOG.1.0]

DEF host_call(op, a, b, c) {
    RETURN host(op, a, b, c);
}

DEF save(path, content) {
    RETURN host_call("write_text", path, content, NULL);
}

DEF join(xs, delim) {
    RETURN host_call("str_join", xs, delim, NULL);
}

DEF list_create() {
    RETURN host_call("list_new", NULL, NULL, NULL);
}

DEF list_add(xs, item) {
    RETURN host_call("list_push", xs, item, NULL);
}

DEF register_section_field(storage, section_id, field_name, field_desc) {
    ⚡ list_add(storage, field_name);
    ⚡ print("TELEMETRY_TEMPLATE [", section_id, "]->", field_name, ":", field_desc);
    RETURN storage;
}

