#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.LANGUAGE.SELF_DIRECTION][VERSION=0.2]

⟡(Σ.SELF_OBSERVE) {
    ⚡ declared: 6;
    ⚡ observed: 0;
    ⚡ contradicted: 0;

    ⚡ print(declared);
    ⚡ print(observed);
    ⚡ print(declared - observed);
    ⚡ print(contradicted);

    IF (contradicted > 0) {
        ⚡ print(1);
    } ELSE {
        ⚡ print(0);
    }

    IF (observed < declared) {
        ⚡ print(1);
    } ELSE {
        ⚡ print(0);
    }
}
