#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.SHELL.OBSERVATION.ACTION][VERSION=0.1]

DEF H(op,a,b,c){
    RETURN host(op,a,b,c);
}

⟡(Σ.SHELL_OBSERVATION_ACTION) {

    ⚡ OBSERVATION_A:
        H("input","",NULL,NULL);

    ⚡ OBSERVATION_B:
        H("input","",NULL,NULL);


    ⚡ RELATION:
        OBSERVATION_A == OBSERVATION_B;


    ⋈ ACTION {

        IF (RELATION) {
            ⚡ print("SAME");
        } ELSE {
            ⚡ print("DIFFERENT");
        }

    }

}
