    ⚡ STATE:
        "READY";


    ⚡ COMMAND:
        "help";


    ⚡ ACTION:
        "EXECUTE";


    ⚡ RESULT:
        "SUCCESS";


    ⚡ COMMAND_RELATION:
        "COMMAND→ACTION→RESULT";


    print("============================================");
