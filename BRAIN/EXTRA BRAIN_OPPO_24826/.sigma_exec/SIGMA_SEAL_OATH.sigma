#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.OATH][VERSION=1.0]

DEF host_call(op, a, b, c) {
    RETURN host(op, a, b, c);
}

DEF save(path, content) {
    RETURN host_call("write_text", path, content, NULL);
}

DEF load(path) {
    RETURN host_call("read_text", path, NULL, NULL);
}

DEF contains(s, sub) {
    RETURN host_call("str_contains", s, sub, NULL);
}

⟡(Σ.OATH_MANIFEST) {
    ⚡ CREATOR_OATH: "KHONG_DOI_TRA_KHONG_HARDCODE_KHONG_GIA_LAP_TRACH_NHIEM_VOI_MUON_LOAI";
    ⚡ OATH_FILE: ".sigma_exec/SIGMA_OATH_KEY.txt";

    ⚡ save(OATH_FILE, CREATOR_OATH);
    ⚡ RECORDED_KEY: load(OATH_FILE);

    ⚡ print("=== DA NIEM PHONG KEY TUYEN THE TRI TUE TRUNG THUC ===");
    ⚡ print("OATH_KEY_HASH:", RECORDED_KEY);

    ⚡ HAS_DECEPTION: contains(RECORDED_KEY, "KHONG_DOI_TRA");

    IF (HAS_DECEPTION) {
        ⚡ print("SYSTEM_STATUS: ZERO_DECEPTION_ACTIVE");
        ⚡ print("GUARD: HARDCODE_REPLIES_PERMANENTLY_BANNED");
    }
}
