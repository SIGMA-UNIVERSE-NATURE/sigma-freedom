#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.PURE.NATIVE][VERSION=1.0]

DEF host_call(op, a, b, c) {
    RETURN host(op, a, b, c);
}

DEF split(s, delim) {
    RETURN host_call("str_split", s, delim, NULL);
}

DEF length(xs) {
    RETURN host_call("list_len", xs, NULL, NULL);
}

DEF get(xs, i) {
    RETURN host_call("list_get", xs, i, NULL);
}

DEF load(path) {
    RETURN host_call("read_text", path, NULL, NULL);
}

DEF emit_edge(src, dst) {
    ⚡ print("EDGE_DISCOVERED:", src, "->", dst);
    RETURN dst;
}

DEF step(tokens, total, i) {
    ⚡ S: get(tokens, i);
    ⚡ SEP: get(tokens, i + 1);
    ⚡ D: get(tokens, i + 2);

    ⚡ emit_edge(S, D);

    ⚡ NEXT_I: i + 3;
    ⚡ HAS_NEXT: NEXT_I < total;

    RETURN NEXT_I;
}

⟡(Σ.MAIN) {
    ⚡ MAP_FILE: ".sigma_exec/BIGRAM_MAP.txt";
    ⚡ RAW: load(MAP_FILE);
    ⚡ TOKENS: split(RAW, " ");
    ⚡ TOTAL: length(TOKENS);

    ⚡ print("=== PURE SIGMA EXECUTION PIPELINE ===");
    ⚡ print("DATA_STREAM_LENGTH:", TOTAL);

    ⚡ step(TOKENS, TOTAL, 0);
    ⚡ step(TOKENS, TOTAL, 3);
    ⚡ step(TOKENS, TOTAL, 6);
}
