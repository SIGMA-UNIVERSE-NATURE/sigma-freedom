#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.SHELL][VERSION=0.5]

DEF H(op, a, b, c) {
    RETURN host(op, a, b, c);
}

⟡(Σ.SHELL) {

    ⚡ OBSERVATION:
        H("input", "", NULL, NULL);

    ⚡ SECOND_USE:
        OBSERVATION;


    ⋈ ACTION {

        ⚡ print("============================================");
        ⚡ print("Σ.SHELL — STEP 7B REUSE OBSERVATION");
        ⚡ print("============================================");

        ⚡ print(SECOND_USE);

        ⚡ print("SIGMA_SHELL_STOPPED");
    }
}
