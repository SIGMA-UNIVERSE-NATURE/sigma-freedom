#SIGMAUNIVERSE_LANGUAGE[DOMAIN=AAA.GATEKEEPER][VERSION=F174.ROUTING.1.0]

DEF host_call(op, a, b, c) {
    RETURN host(op, a, b, c);
}

DEF save(path, content) {
    RETURN host_call("write_text", path, content, NULL);
}

DEF join(xs, delim) {
    RETURN host_call("str_join", xs, delim, NULL);
}

DEF list_create() {
    RETURN host_call("list_new", NULL, NULL, NULL);
}

DEF list_add(xs, item) {
    RETURN host_call("list_push", xs, item, NULL);
}

DEF register_routing_schema(storage, field_name, desc) {
    ⚡ list_add(storage, field_name);
    ⚡ print("ROUTING_INPUT_FIELD [", field_name, "]:", desc);
    RETURN storage;
}

DEF register_gate_state_policy(storage, state_id, condition, action, allowed, forbidden) {
    ⚡ list_add(storage, state_id);
    ⚡ print("-----------------------------------------------------------------");
    ⚡ print("GATE_STATE_LAW [", state_id, "]");
    ⚡ print("  CONDITION :", condition);
    ⚡ print("  ACTION    :", action);
    ⚡ print("  ALLOWED   :", allowed);
    ⚡ print("  FORBIDDEN :", forbidden);
    RETURN storage;
}

