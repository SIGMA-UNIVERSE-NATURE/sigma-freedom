    ⚡ register_gate_rule(STORAGE, "GATE_MUTATION_SURVIVAL", "ZERO_CRITICAL", "Critical mutation survival must be strictly zero");
    ⚡ register_gate_rule(STORAGE, "GATE_QA_OF_QA", "META_VERIFY", "QA-of-QA failure automatically invalidates cycle pass");
    ⚡ register_gate_rule(STORAGE, "GATE_RELEASE_AUTH", "INDEPENDENT_JUDGE", "Release closed until independent Release Judge confirms pass");

    ⚡ print("--- [ MUTATION SCORE & QA METRICS ] ---");
    ⚡ register_turbo_param(STORAGE, "MS", "M_DETECTED_DIV_M_VALID", "Mutation score ratio");
