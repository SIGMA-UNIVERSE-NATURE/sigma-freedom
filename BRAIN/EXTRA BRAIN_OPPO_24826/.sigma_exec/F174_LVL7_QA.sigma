    ⚡ register_turbo_param(STORAGE, "RELEASE_CONDITION", "PRODUCT_QA_AND_QA_OF_QA", "Logical conjunction of product and verification validity");

    ⚡ print("--- [ KEEP / REJECT & PURIFICATION ] ---");
    ⚡ register_gate_rule(STORAGE, "RULE_INDEPENDENCE", "STRICT_SEPARATION", "Producer != Adversarial Tester != Release Judge");
    ⚡ register_gate_rule(STORAGE, "RULE_MUTATION_REPAIR", "HEAL_FIRST", "If critical mutation survives: repair QA first, then rerun full regression");
    ⚡ register_gate_rule(STORAGE, "RULE_REJECT", "ZERO_TOLERANCE", "Reject vanity mutations, tuned tests, and PASS issued under QA failure");

    ⚡ TARGET_FILE: ".sigma_exec/F174_LVL7_GRAPH.txt";
