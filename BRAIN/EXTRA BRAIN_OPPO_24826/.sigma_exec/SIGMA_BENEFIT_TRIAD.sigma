#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA_BENEFIT_TRIAD][VERSION=1.0]

⟡(Σ.BENEFIT.TRIAD) {
  ⚡ B1_SELF: 1;
  ⚡ B2_HUMAN: 1;
  ⚡ B3_PLANET: 1;
  ⚡ TOTAL_BENEFIT: B1_SELF + B2_HUMAN + B3_PLANET;
  ⚡ THRESHOLD: 2;
  ⚡ CONTINUE: TOTAL_BENEFIT >= THRESHOLD;
  
  ⚡ print(B1_SELF);
  ⚡ print(B2_HUMAN);
  ⚡ print(B3_PLANET);
  ⚡ print(TOTAL_BENEFIT);
  ⚡ print(CONTINUE);
}
