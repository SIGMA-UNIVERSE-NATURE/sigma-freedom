#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.SHELL][VERSION=0.5]

⟡(Σ.SHELL) {

    ⚡ HISTORY_A:
        host(
            "read_text",
            ".sigma_exec/SIGMA_SHELL_HISTORY_A.memory",
            NULL,
            NULL
        );

    ⚡ HISTORY_B:
        host(
            "read_text",
            ".sigma_exec/SIGMA_SHELL_HISTORY_B.memory",
            NULL,
            NULL
        );

    ⚡ QUERY:
        host("input","Σ> ",NULL,NULL);

    ⚡ MATCH_A:
        QUERY == HISTORY_A;

    ⚡ MATCH_B:
        QUERY == HISTORY_B;

    print(HISTORY_A);
    print(HISTORY_B);
    print(QUERY);
    print(MATCH_A);
    print(MATCH_B);
}
