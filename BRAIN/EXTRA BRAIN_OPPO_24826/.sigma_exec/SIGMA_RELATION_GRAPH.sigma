#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.DATA.GRAPH][VERSION=1.0]

DEF host_call(op, a, b, c) {
    RETURN host(op, a, b, c);
}

DEF split(s, delim) {
    RETURN host_call("str_split", s, delim, NULL);
}

DEF length(xs) {
    RETURN host_call("list_len", xs, NULL, NULL);
}

DEF get(xs, i) {
    RETURN host_call("list_get", xs, i, NULL);
}

DEF save(path, content) {
    RETURN host_call("write_text", path, content, NULL);
}

DEF join(xs, delim) {
    RETURN host_call("str_join", xs, delim, NULL);
}

DEF list_create() {
    RETURN host_call("list_new", NULL, NULL, NULL);
}

DEF list_add(xs, item) {
    RETURN host_call("list_push", xs, item, NULL);
}

⟡(Σ.MAIN) {
    ⚡ STREAM: "A B C D";
    ⚡ TOKENS: split(STREAM, " ");
    ⚡ TOTAL: length(TOKENS);

    ⚡ EDGES: list_create();

    ⚡ I: 0;
    WHILE (I < TOTAL - 1) {
        ⚡ NODE_1: get(TOKENS, I);
        ⚡ NODE_2: get(TOKENS, I + 1);
        ⚡ EDGE: join(split(NODE_1, " "), "");
        
        ⚡ list_add(EDGES, NODE_1);
        ⚡ list_add(EDGES, "->");
        ⚡ list_add(EDGES, NODE_2);
        
        ⚡ print("EDGE_BUILT", NODE_1, "->", NODE_2);
        ⚡ I: I + 1;
    }

    ⚡ GRAPH_FILE: ".sigma_exec/RELATION_GRAPH.txt";
    ⚡ RAW_EDGES: join(EDGES, " ");
    ⚡ save(GRAPH_FILE, RAW_EDGES);
    ⚡ print("GRAPH_SAVED_TO_DISK", GRAPH_FILE);
}
