#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.STRUCTURAL.NGRAM][VERSION=1.0]

DEF host_call(op, a, b, c) {
    RETURN host(op, a, b, c);
}

DEF split(s, delim) {
    RETURN host_call("str_split", s, delim, NULL);
}

DEF length(xs) {
    RETURN host_call("list_len", xs, NULL, NULL);
}

DEF get(xs, i) {
    RETURN host_call("list_get", xs, i, NULL);
}

DEF save(path, content) {
    RETURN host_call("write_text", path, content, NULL);
}

DEF join(xs, delim) {
    RETURN host_call("str_join", xs, delim, NULL);
}

DEF list_create() {
    RETURN host_call("list_new", NULL, NULL, NULL);
}

DEF list_add(xs, item) {
    RETURN host_call("list_push", xs, item, NULL);
}

⟡(Σ.MAIN) {
    ⚡ CORPUS: "Y DAN DAU CAC PHAP Y LAM CHU Y TAO";
    ⚡ TOKENS: split(CORPUS, " ");
    ⚡ TOTAL: length(TOKENS);

    ⚡ BIGRAMS: list_create();

    ⚡ print("CORPUS_INPUT:", CORPUS);
    ⚡ print("TOTAL_TOKENS:", TOTAL);

    ⚡ I: 0;
    WHILE (I < TOTAL - 1) {
        ⚡ W1: get(TOKENS, I);
        ⚡ W2: get(TOKENS, I + 1);

        ⚡ PAIR: join(split(W1, " "), "");
        ⚡ list_add(BIGRAMS, W1);
        ⚡ list_add(BIGRAMS, "~");
        ⚡ list_add(BIGRAMS, W2);

        ⚡ print("TRANSITION_EXTRACTED:", W1, "->", W2);
        ⚡ I: I + 1;
    }

    ⚡ LOG_FILE: ".sigma_exec/BIGRAM_MAP.txt";
    ⚡ SERIALIZED: join(BIGRAMS, " ");
    ⚡ save(LOG_FILE, SERIALIZED);
    ⚡ print("BIGRAM_MAP_SAVED:", LOG_FILE);
}
