#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.SHELL.EXPERIENCE.INFLUENCE.ACTION][VERSION=0.1]

DEF H(op,a,b,c){
    RETURN host(op,a,b,c);
}

⟡(Σ.SHELL_EXPERIENCE_INFLUENCE_ACTION) {

    ⚡ EXPERIENCE:
        H("input","",NULL,NULL);

    ⚡ MEMORY_WRITE:
        H("write_text",
          "sigma_shell_experience_influence.state",
          EXPERIENCE,
          NULL);


    ⚡ NEXT_EVENT:
        H("input","",NULL,NULL);

    ⚡ RECALLED_EXPERIENCE:
        H("read_text",
          "sigma_shell_experience_influence.state",
          NULL,NULL);


    ⋈ ACTION {

        ⚡ print(RECALLED_EXPERIENCE);

        ⚡ print(NEXT_EVENT);

    }

}
