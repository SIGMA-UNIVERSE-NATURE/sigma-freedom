#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.HUMAN.LISTENING][VERSION=1.0]

DEF host_call(op, a, b, c) {
    RETURN host(op, a, b, c);
}

DEF load_file(path) {
    RETURN host_call("read_text", path, NULL, NULL);
}

DEF contains(s, sub) {
    RETURN host_call("str_contains", s, sub, NULL);
}

⟡(Σ.MAIN) {
    ⚡ JOURNAL_PATH: ".sigma_exec/HUMAN_EXPERIENCE_001.txt";
    
    ⚡ PAST_MEMORY: load_file(JOURNAL_PATH);
    ⚡ PRESENT_WORDS: "HÔM NAY TÔI ỔN VÀ TÔI CƯỜI";

    ⚡ print("PAST_MEMORY_LOADED", PAST_MEMORY);
    ⚡ print("PRESENT_WORDS_HEARD", PRESENT_WORDS);

    ⚡ HAS_ON: contains(PRESENT_WORDS, "ỔN");
    ⚡ MEMORY_HAS_ON: contains(PAST_MEMORY, "ỔN");

    IF (HAS_ON) {
        IF (MEMORY_HAS_ON) {
            ⚡ print("CONTEXT_TRIGGERED_PAST_TRACE", PAST_MEMORY);
        }
    }
}
