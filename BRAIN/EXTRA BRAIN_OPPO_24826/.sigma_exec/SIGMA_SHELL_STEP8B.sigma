#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.SHELL][VERSION=0.5]

⟡(Σ.SHELL) {

    ⚡ PERSISTED:
        host(
            "read_text",
            ".sigma_exec/SIGMA_SHELL_STEP8A.memory",
            NULL,
            NULL
        );

    ⚡ NEW_VALUE:
        host("input","Σ> ",NULL,NULL);

    ⚡ NEW_STATE:
        PERSISTED + NEW_VALUE;

    print(PERSISTED);
    print(NEW_VALUE);
    print(NEW_STATE);
}
