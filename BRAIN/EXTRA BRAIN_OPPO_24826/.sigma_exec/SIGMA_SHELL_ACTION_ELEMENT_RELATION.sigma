#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.SHELL.ACTION.ELEMENT.RELATION][VERSION=0.1]

DEF H(op,a,b,c){
    RETURN host(op,a,b,c);
}

⟡(Σ.SHELL_ACTION_ELEMENT_RELATION) {

    ⚡ OBSERVATION_A:
        H("input","",NULL,NULL);

    ⚡ OBSERVATION_B:
        H("input","",NULL,NULL);


    ⚡ RELATION:
        OBSERVATION_A == OBSERVATION_B;


