          NULL);


    ⚡ READ_RELATION:
        H("read_text",
          "sigma_shell_relation.state",
          NULL,NULL);


    ⋈ ACTION {

        ⚡ print("============================================");
        ⚡ print("Σ.SHELL RELATION OBSERVATION");
        ⚡ print("============================================");

        ⚡ print(OBSERVATION_A);

        ⚡ print(OBSERVATION_B);

        ⚡ print(READ_RELATION);

        ⚡ print("SIGMA_SHELL_STOPPED");
    }

}
