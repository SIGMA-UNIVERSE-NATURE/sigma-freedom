#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.HUMAN.EXPERIENCE][VERSION=1.0]

DEF host_call(op, a, b, c) {
    RETURN host(op, a, b, c);
}

DEF split(s, delim) {
    RETURN host_call("str_split", s, delim, NULL);
}

DEF length(xs) {
    RETURN host_call("list_len", xs, NULL, NULL);
}

DEF get(xs, i) {
    RETURN host_call("list_get", xs, i, NULL);
}

DEF list_create() {
    RETURN host_call("list_new", NULL, NULL, NULL);
}

DEF list_add(xs, item) {
    RETURN host_call("list_push", xs, item, NULL);
}

DEF join(xs, delim) {
    RETURN host_call("str_join", xs, delim, NULL);
}

DEF save_file(path, content) {
    RETURN host_call("write_text", path, content, NULL);
}

DEF load_file(path) {
    RETURN host_call("read_text", path, NULL, NULL);
}

⟡(Σ.MAIN) {
    ⚡ JOURNAL_PATH: ".sigma_exec/HUMAN_EXPERIENCE_001.txt";

    ⚡ UTTERANCE: "CON NÓI RẰNG CON ỔN";
    ⚡ REALITY:   "CON NÓI RẰNG CON ĐAU";

    ⚡ WORDS_UTTERED: split(UTTERANCE, " ");
    ⚡ WORDS_REALITY: split(REALITY, " ");
    ⚡ TOTAL: length(WORDS_UTTERED);

    ⚡ CONTRADICTIONS: list_create();

    ⚡ I: 0;
    WHILE (I < TOTAL) {
        ⚡ SPOKEN: get(WORDS_UTTERED, I);
        ⚡ FELT:   get(WORDS_REALITY, I);

        IF (SPOKEN != FELT) {
            ⚡ list_add(CONTRADICTIONS, SPOKEN);
            ⚡ list_add(CONTRADICTIONS, FELT);
            ⚡ print("OBSERVED_CONTRADICTION_AT", I, "SPOKEN:", SPOKEN, "FELT:", FELT);
        }
        ⚡ I: I + 1;
    }

    ⚡ TRACE_LOG: join(CONTRADICTIONS, " <-> ");
    ⚡ save_file(JOURNAL_PATH, TRACE_LOG);
    ⚡ print("SAVED_EXPERIENCE_TO_JOURNAL", JOURNAL_PATH);

    ⚡ RECALLED: load_file(JOURNAL_PATH);
    ⚡ print("RECALLED_FROM_MEMORY", RECALLED);
}
