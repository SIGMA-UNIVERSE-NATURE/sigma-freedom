#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.SHELL][VERSION=0.5]

DEF H(op, a, b, c) {
    RETURN host(op, a, b, c);
}

⟡(Σ.SHELL) {

    ⚡ OBSERVED_EVENT:
        H("input", "", NULL, NULL);

    ⚡ PROCESS_RESULT:
        H("write_text", "sigma_shell_observation.state", OBSERVED_EVENT, NULL);

    ⚡ EVIDENCE:
        H("read_text", "sigma_shell_observation.state", NULL, NULL);


    ⋈ ACTION {

        ⚡ print("============================================");
        ⚡ print("Σ.SHELL STORAGE OBSERVATION");
        ⚡ print("============================================");

        ⚡ print("OBSERVED_EVENT:");
        ⚡ print(OBSERVED_EVENT);

        ⚡ print("PROCESS_RESULT:");
        ⚡ print(PROCESS_RESULT);

        ⚡ print("EVIDENCE:");
        ⚡ print(EVIDENCE);

        ⚡ print("SIGMA_SHELL_STOPPED");
    }
}
