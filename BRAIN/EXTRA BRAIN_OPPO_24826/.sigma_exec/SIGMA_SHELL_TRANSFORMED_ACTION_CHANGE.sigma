#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.SHELL.TRANSFORMED.ACTION.CHANGE][VERSION=0.1]

DEF H(op,a,b,c){
    RETURN host(op,a,b,c);
}

⟡(Σ.SHELL_TRANSFORMED_ACTION_CHANGE) {

    ⚡ OBSERVATION:
        H("input","",NULL,NULL);

    ⚡ TRANSFORMED:
        H("str_split", OBSERVATION, " ", NULL);

    ⚡ ACTION_RESULT:
        H("list_len", TRANSFORMED, NULL, NULL);


    ⋈ ACTION {

        ⚡ print(OBSERVATION);

        ⚡ print(ACTION_RESULT);

    }

}
