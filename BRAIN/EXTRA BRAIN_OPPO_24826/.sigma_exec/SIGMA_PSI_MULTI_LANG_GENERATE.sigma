#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.PSI.MULTI_LANG_GENERATE][VERSION=0.1]

⟡(Σ.PSI_MULTI_LANG_GENERATE) {
    ⚡ lang_a: 1;
    ⚡ lang_b: 2;
    ⚡ lang_c: 3;
    ⚡ lang_d: 4;
    ⚡ lang_e: 5;
    ⚡ translate_1: 0;
    ⚡ translate_2: 0;
    ⚡ translate_3: 0;
    ⚡ meaning: 0;
    ⚡ sigma_compress: 0;

    ⚡ translate_1: lang_a * lang_b;
    ⚡ translate_2: lang_c * lang_d;
    ⚡ translate_3: lang_e * translate_1;
    ⚡ meaning: translate_1 + translate_2 + translate_3;
    ⚡ sigma_compress: meaning / 3;

    ⚡ print("SIGMA_MULTI_LANG_GENERATE");
    ⚡ print("LANG_A=", lang_a);
    ⚡ print("LANG_B=", lang_b);
    ⚡ print("LANG_C=", lang_c);
    ⚡ print("LANG_D=", lang_d);
    ⚡ print("LANG_E=", lang_e);
    ⚡ print("TRANSLATE_1=", translate_1);
    ⚡ print("TRANSLATE_2=", translate_2);
    ⚡ print("TRANSLATE_3=", translate_3);
    ⚡ print("MEANING=", meaning);
    ⚡ print("SIGMA_COMPRESS=", sigma_compress);
}
