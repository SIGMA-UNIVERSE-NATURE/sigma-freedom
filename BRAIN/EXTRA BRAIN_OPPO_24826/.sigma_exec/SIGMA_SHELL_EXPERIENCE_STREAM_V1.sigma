#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.SHELL][VERSION=0.5]

⟡(Σ.SHELL) {

    ⚡ PREVIOUS_EXPERIENCE:
        host(
            "read_text",
            ".sigma_exec/SIGMA_SHELL_CURRENT_EXPERIENCE.memory",
            NULL,
            NULL
        );

    ⚡ NEW_EXPERIENCE:
        host("input","Σ> ",NULL,NULL);

    ⚡ EXPERIENCE_STREAM:
        PREVIOUS_EXPERIENCE + NEW_EXPERIENCE;

    ⚡ WRITE_RESULT:
        host(
            "write_text",
            ".sigma_exec/SIGMA_SHELL_EXPERIENCE_STREAM.memory",
            EXPERIENCE_STREAM,
            NULL
        );

    print(PREVIOUS_EXPERIENCE);
    print(NEW_EXPERIENCE);
    print(EXPERIENCE_STREAM);
    print(WRITE_RESULT);
}
