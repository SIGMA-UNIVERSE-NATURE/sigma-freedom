#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.EXPERIENCE.DERIVED.RELATION][VERSION=0.1]

DEF H(op,a,b,c){
    RETURN host(op,a,b,c);
}

⟡(Σ.EXPERIENCE_DERIVED_RELATION) {

    ⚡ EXPERIENCE:
        H("input","",NULL,NULL);

    ⚡ EXPERIENCE_STRUCTURE:
        H("str_split",
          EXPERIENCE,
          " ",
          NULL);

    ⚡ INTERNAL_STATE:
        H("list_len",
          EXPERIENCE_STRUCTURE,
          NULL,
          NULL);


    ⚡ NEXT_EVENT:
        H("input","",NULL,NULL);

    ⚡ NEXT_STRUCTURE:
        H("str_split",
          NEXT_EVENT,
          " ",
          NULL);

    ⚡ NEXT_STATE:
        H("list_len",
          NEXT_STRUCTURE,
          NULL,
          NULL);


    ⚡ DERIVED_RELATION:
        INTERNAL_STATE == NEXT_STATE;


    ⚡ ACTION:
        DERIVED_RELATION;


    ⋈ ACTION {

        ⚡ print(INTERNAL_STATE);

        ⚡ print(NEXT_STATE);

        ⚡ print(DERIVED_RELATION);

        ⚡ print(ACTION);

    }

}
