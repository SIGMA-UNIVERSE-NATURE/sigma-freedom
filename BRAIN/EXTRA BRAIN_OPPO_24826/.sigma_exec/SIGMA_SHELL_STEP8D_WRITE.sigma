#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.SHELL][VERSION=0.5]

⟡(Σ.SHELL) {

    ⚡ FIRST_EXPERIENCE:
        host("input","Σ1> ",NULL,NULL);

    ⚡ SECOND_EXPERIENCE:
        host("input","Σ2> ",NULL,NULL);

    ⚡ WRITE_FIRST:
        host(
            "write_text",
            ".sigma_exec/SIGMA_SHELL_STEP8D_FIRST.memory",
            FIRST_EXPERIENCE,
            NULL
        );

    ⚡ WRITE_SECOND:
        host(
            "write_text",
            ".sigma_exec/SIGMA_SHELL_STEP8D_SECOND.memory",
            SECOND_EXPERIENCE,
            NULL
        );

    print(FIRST_EXPERIENCE);
    print(SECOND_EXPERIENCE);
    print(WRITE_FIRST);
    print(WRITE_SECOND);
}
