#SIGMAUNIVERSE_LANGUAGE[DOMAIN=AAA.FIRST_RUN][VERSION=F174.97A.1.0]

DEF host_call(op, a, b, c) {
    RETURN host(op, a, b, c);
}

DEF save(path, content) {
    RETURN host_call("write_text", path, content, NULL);
}

DEF join(xs, delim) {
    RETURN host_call("str_join", xs, delim, NULL);
}

DEF list_create() {
    RETURN host_call("list_new", NULL, NULL, NULL);
}

DEF list_add(xs, item) {
    RETURN host_call("list_push", xs, item, NULL);
}

DEF execute_action(log, step_id, action_name, target_state) {
    ⚡ list_add(log, step_id);
    ⚡ print("-----------------------------------------------------------------");
    ⚡ print("EXECUTE_ACTION [", step_id, "]:", action_name);
    ⚡ print("  STATUS :", target_state);
    RETURN log;
}

