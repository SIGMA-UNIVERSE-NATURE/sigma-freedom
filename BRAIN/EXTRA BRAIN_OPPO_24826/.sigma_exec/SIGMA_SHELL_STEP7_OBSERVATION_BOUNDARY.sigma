    RETURN host(op,a,b,c);
}

⟡(Σ.SHELL_OBSERVATION_BOUNDARY) {

    ⚡ OBSERVATION:
        H("input","",NULL,NULL);

    ⚡ MEMORY:
        H("write_text",
