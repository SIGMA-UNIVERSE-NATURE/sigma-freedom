#SIGMAUNIVERSE_LANGUAGE[DOMAIN=AAA.CERTIFICATE][VERSION=F174.LIBCERT.1.0]

DEF host_call(op, a, b, c) {
    RETURN host(op, a, b, c);
}

DEF save(path, content) {
    RETURN host_call("write_text", path, content, NULL);
}

DEF join(xs, delim) {
    RETURN host_call("str_join", xs, delim, NULL);
}

DEF list_create() {
    RETURN host_call("list_new", NULL, NULL, NULL);
}

DEF list_add(xs, item) {
    RETURN host_call("list_push", xs, item, NULL);
}

DEF register_audit_stat(storage, check_name, score, result) {
    ⚡ list_add(storage, check_name);
    ⚡ print("AUDIT_METRIC [", check_name, "]:", score, "==>", result);
    RETURN storage;
}

DEF register_scope_claim(storage, claim_type, text) {
    ⚡ list_add(storage, claim_type);
    ⚡ print("CERT_CLAIM [", claim_type, "]:", text);
    RETURN storage;
}

