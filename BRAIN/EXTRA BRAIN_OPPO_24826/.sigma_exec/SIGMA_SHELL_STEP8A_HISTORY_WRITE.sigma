#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.SHELL][VERSION=0.5]

⟡(Σ.SHELL) {

    ⚡ EXPERIENCE_A:
        host("input","Σ1> ",NULL,NULL);

    ⚡ EXPERIENCE_B:
        host("input","Σ2> ",NULL,NULL);

    ⚡ WRITE_A:
        host(
            "write_text",
            ".sigma_exec/SIGMA_SHELL_HISTORY_A.memory",
            EXPERIENCE_A,
            NULL
        );

    ⚡ WRITE_B:
        host(
            "write_text",
            ".sigma_exec/SIGMA_SHELL_HISTORY_B.memory",
            EXPERIENCE_B,
            NULL
        );

    print(EXPERIENCE_A);
    print(EXPERIENCE_B);
    print(WRITE_A);
    print(WRITE_B);
}
