    ⚡ print("PARENT     : 93_TURBO_EXPERIMENT_AND_TELEMETRY_LOG");
    ⚡ print("CORE LAW   : F174_VERIFIED_CORE = IMMUTABLE");

    ⚡ STORAGE: list_create();

    ⚡ print("--- [ CERTIFICATE ISSUANCE LAWS ] ---");
    ⚡ register_gate_rule(STORAGE, "RULE_STRICT_SCOPE", "BOUNDED", "Certificate verifies only explicitly named artifact, scope, and evidence");
    ⚡ register_gate_rule(STORAGE, "RULE_FAIL_CLOSED", "NO_PASS_WITHOUT_EV", "PASS is forbidden when required evidence is missing or stale");
    ⚡ register_gate_rule(STORAGE, "RULE_HASH_INVALIDATION", "CHECKSUM_LOCK", "Any artifact mutation invalidates prior certificate");

    ⚡ print("--- [ CERTIFICATE TYPE MATRIX ] ---");
    ⚡ register_cert_type(STORAGE, "CORE_CERT",
        "Exact F174 mathematical core and immutable checksum",
        "Proof archive, assumptions, independent verification, checksum",
        "Empirical truth outside assumptions; later operational formulas",
        "All proof claims and boundaries independently PASS");

    ⚡ register_cert_type(STORAGE, "LIBRARY_CERT",
        "Turbo Library structure, load order, files, parents, and non-bypass laws",
        "00 Boot, Index, Levels 01-10, support files 90-99, manifest/checksums",
        "Runtime speed, k values, true bottleneck, or reserve performance",
        "All required files present, readable, nonconflicting, checksum-bound");

    ⚡ register_cert_type(STORAGE, "MODULE_CERT",
        "One Turbo level purpose, formula, activation gate, QA, and rollback",
        "Module file, parent link, nonduplicate purpose, structural QA, checksum",
        "Operational effectiveness before a verified experiment",
        "Structure PASS; no core conflict; all required gates defined");

    ⚡ TARGET_FILE: ".sigma_exec/F174_CERT_STANDARD_GRAPH.txt";
