#SIGMAUNIVERSE_LANGUAGE[DOMAIN=AAA.CERT_STANDARD][VERSION=F174.99.1.0]

DEF host_call(op, a, b, c) {
    RETURN host(op, a, b, c);
}

DEF save(path, content) {
    RETURN host_call("write_text", path, content, NULL);
}

DEF join(xs, delim) {
    RETURN host_call("str_join", xs, delim, NULL);
}

DEF list_create() {
    RETURN host_call("list_new", NULL, NULL, NULL);
}

DEF list_add(xs, item) {
    RETURN host_call("list_push", xs, item, NULL);
}

DEF register_cert_type(storage, cert_type, certifies_scope, req_evidence, cannot_certify, issue_gate) {
    ⚡ list_add(storage, cert_type);
    ⚡ print("-----------------------------------------------------------------");
    ⚡ print("CERTIFICATE_TYPE [", cert_type, "]");
    ⚡ print("  CERTIFIES     :", certifies_scope);
    ⚡ print("  MANDATORY EV. :", req_evidence);
    ⚡ print("  CANNOT CERTIFY:", cannot_certify);
    ⚡ print("  ISSUE GATE    :", issue_gate);
    RETURN storage;
}

DEF register_gate_rule(storage, rule_id, rule_type, condition_text) {
    ⚡ list_add(storage, rule_id);
    ⚡ print("CERT_ISSUANCE_LAW [", rule_id, "|", rule_type, "]:", condition_text);
    RETURN storage;
}

⟡(Σ.LOAD_F174_CERT_STANDARD) {
    ⚡ print("=================================================================");
