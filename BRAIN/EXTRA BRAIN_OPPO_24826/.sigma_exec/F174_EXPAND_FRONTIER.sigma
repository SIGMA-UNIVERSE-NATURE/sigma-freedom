#SIGMAUNIVERSE_LANGUAGE[DOMAIN=AAA.TURBO][VERSION=F174.EXPAND.1.0]

DEF host_call(op, a, b, c) {
    RETURN host(op, a, b, c);
}

DEF save(path, content) {
    RETURN host_call("write_text", path, content, NULL);
}

DEF join(xs, delim) {
    RETURN host_call("str_join", xs, delim, NULL);
}

DEF list_create() {
    RETURN host_call("list_new", NULL, NULL, NULL);
}

DEF list_add(xs, item) {
    RETURN host_call("list_push", xs, item, NULL);
}

DEF register_gate_output_unit(storage, gate_name, valid_unit_def) {
    ⚡ list_add(storage, gate_name);
    ⚡ print("GATE_UNIT_MAPPED [", gate_name, "] -> NATIVE_VALID_UNIT:", valid_unit_def);
    RETURN storage;
}

DEF register_frontier_rule(storage, rule_id, rule_desc) {
    ⚡ list_add(storage, rule_id);
    ⚡ print("FRONTIER_EXPANSION_LOCKED [", rule_id, "]:", rule_desc);
    RETURN storage;
}

