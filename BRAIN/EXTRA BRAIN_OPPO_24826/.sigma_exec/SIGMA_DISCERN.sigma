#SIGMAUNIVERSE_LANGUAGE[DOMAIN=SIGMA.STRUCTURAL.DISCERNMENT][VERSION=1.0]

DEF host_call(op, a, b, c) {
    RETURN host(op, a, b, c);
}

DEF split(s, delim) {
    RETURN host_call("str_split", s, delim, NULL);
}

DEF length(xs) {
    RETURN host_call("list_len", xs, NULL, NULL);
}

DEF get(xs, i) {
    RETURN host_call("list_get", xs, i, NULL);
}

DEF contains(s, sub) {
    RETURN host_call("str_contains", s, sub, NULL);
}

⟡(Σ.MAIN) {
    ⚡ EXPRESSION: "NGOAI_MAT_CUOI_NHUNG_TRONG_LONG_DAU";
    ⚡ CLAUSES: split(EXPRESSION, "_NHUNG_");
    ⚡ TOTAL_CLAUSES: length(CLAUSES);

    ⚡ print("BIEU_DAT_DA_TANG:", EXPRESSION);
    ⚡ print("SO_LUONG_VE_DOI_LAP:", TOTAL_CLAUSES);

    ⚡ SURFACE_LAYER: get(CLAUSES, 0);
    ⚡ DEEP_LAYER: get(CLAUSES, 1);

    ⚡ print("TANG_BE_MAT_SURFACE:", SURFACE_LAYER);
    ⚡ print("TANG_SAU_KIN_CORE:", DEEP_LAYER);

    ⚡ HAS_CUOI: contains(SURFACE_LAYER, "CUOI");
    ⚡ HAS_DAU: contains(DEEP_LAYER, "DAU");

    IF (HAS_CUOI) {
        IF (HAS_DAU) {
            ⚡ print("LIEU_TRI_XAC_NHAN: PHAT HIEN SU CHE GIAU (SURFACE_MASK != DEEP_STATE)");
            ⚡ print("DINH_HUONG_THAU_CAM: KHONG PHAN XET BE MAT - LICK VAO NOI SAU CUNG");
        }
    }
}
